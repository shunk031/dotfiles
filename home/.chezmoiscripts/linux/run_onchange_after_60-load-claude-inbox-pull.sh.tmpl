{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

# @file home/.chezmoiscripts/linux/run_onchange_after_60-load-claude-inbox-pull.sh.tmpl
# @brief Reload and enable the Claude inbox pull systemd user timer after its unit files change.
#
# service hash: {{ include "private_dot_config/systemd/user/claude-inbox-pull.service" | sha256sum }}
# timer hash: {{ include "private_dot_config/systemd/user/claude-inbox-pull.timer" | sha256sum }}

set -Eeuo pipefail

systemctl --user daemon-reload
systemctl --user enable --now claude-inbox-pull.timer
{{- end }}
