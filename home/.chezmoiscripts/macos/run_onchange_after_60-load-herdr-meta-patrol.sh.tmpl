{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

# @file home/.chezmoiscripts/macos/run_onchange_after_60-load-herdr-meta-patrol.sh.tmpl
# @brief Reload the herdr-meta-patrol LaunchAgent when its definition changes.
# plist hash: {{ include "private_Library/LaunchAgents/com.shunk031.herdr-meta-patrol.plist.tmpl" | sha256sum }}

set -Eeuo pipefail

label="com.shunk031.herdr-meta-patrol"
mkdir -p "${HOME}/.local/state/herdr-meta-patrol"
launchctl bootout "gui/$(id -u)/${label}" 2> /dev/null || true
launchctl bootstrap "gui/$(id -u)" "${HOME}/Library/LaunchAgents/${label}.plist"
{{- end }}
