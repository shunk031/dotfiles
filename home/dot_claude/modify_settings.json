{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if ne .chezmoi.stdin "" -}}
  {{- $current = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (kindIs "map" $current) -}}
  {{- fail "Claude Code settings must be a JSON object" -}}
{{- end -}}
{{- if kindIs "map" (get $current "extraKnownMarketplaces") -}}
  {{- $_ := unset (get $current "extraKnownMarketplaces") "ponytail" -}}
{{- end -}}
{{- $managed := mustFromJson `{
  "model": "fable",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "low"
    }
  },
  "alwaysThinkingEnabled": true,
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "promptSuggestionEnabled": false,
  "env": {
    "DISABLE_UPDATES": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Read(.env.*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Edit(.env*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-uv.sh"
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length pre claude",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length pre claude",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx ruff format"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx ruff check --fix"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx mypy"
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length post claude",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length stop claude",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.agents/date_context.py\" ] && command -v python3 >/dev/null 2>&1; then python3 \"$HOME/.agents/date_context.py\"; else exit 0; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-mem@thedotmack": false,
    "ponytail@ponytail": false,
    "inbox@inbox": true
  },
  "extraKnownMarketplaces": {
    "inbox": {
      "source": {
        "source": "github",
        "repo": "petekp/inbox"
      }
    }
  },
  "tui": "fullscreen"
}` -}}
{{- mergeOverwrite $current $managed | toPrettyJson -}}
