{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if ne .chezmoi.stdin "" -}}
  {{- $current = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (kindIs "map" $current) -}}
  {{- fail "Claude Code settings must be a JSON object" -}}
{{- end -}}
{{- if kindIs "map" (get $current "extraKnownMarketplaces") -}}
  {{- $_ := unset (get $current "extraKnownMarketplaces") "ponytail" -}}
  {{- $_ := unset (get $current "extraKnownMarketplaces") "inbox" -}}
{{- end -}}
{{- if kindIs "map" (get $current "enabledPlugins") -}}
  {{- $_ := unset (get $current "enabledPlugins") "inbox@inbox" -}}
{{- end -}}
{{- $managed := mustFromJson `{
  "model": "fable",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "low"
    }
  },
  "alwaysThinkingEnabled": true,
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "promptSuggestionEnabled": false,
  "env": {
    "DISABLE_UPDATES": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1",
    "INBOX_RECORDED_ITEMS_ONLY": "1"
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Read(.env.*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Edit(.env*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length pre claude",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length pre claude",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx ruff format"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx ruff check --fix"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx mypy"
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length post claude",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; ~/.local/bin/common/markdown-sentence-length stop claude",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.agents/date_context.py\" ] && command -v python3 >/dev/null 2>&1; then python3 \"$HOME/.agents/date_context.py\"; else exit 0; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/.bin/ccstatusline",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-mem@thedotmack": false,
    "ponytail@ponytail": false
  },
  "tui": "fullscreen"
}` -}}
{{- $pluginDirs := list "~/.local/share/claude/plugins/inbox" -}}
{{- if kindIs "map" (get $current "env") -}}
  {{- $currentPluginDirs := get (get $current "env") "CLAUDE_CODE_PLUGIN_DIRS" -}}
  {{- if kindIs "string" $currentPluginDirs -}}
    {{- range splitList ":" $currentPluginDirs -}}
      {{- if and (ne . "") (ne . "~/.local/share/claude/plugins/inbox") (not (has . $pluginDirs)) -}}
        {{- $pluginDirs = append $pluginDirs . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $_ := set (get $managed "env") "CLAUDE_CODE_PLUGIN_DIRS" (join ":" $pluginDirs) -}}
{{- mergeOverwrite $current $managed | toPrettyJson -}}
