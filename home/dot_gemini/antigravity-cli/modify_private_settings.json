{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if ne .chezmoi.stdin "" -}}
  {{- $current = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (kindIs "map" $current) -}}
  {{- fail "Antigravity CLI settings must be a JSON object" -}}
{{- end -}}
{{- /* Normalize agy's omitted default false before comparing managed settings. */ -}}
{{- $current = mergeOverwrite (dict "enableTerminalSandbox" false) $current -}}
{{- $managed := include "private_dot_config/antigravity-cli/settings.json" | mustFromJson -}}
{{- $merged := mergeOverwrite (deepCopy $current) $managed -}}
{{- /* Keep agy's serialization when the managed values already match. */ -}}
{{- if eq (mustToJson $current) (mustToJson $merged) -}}
  {{- .chezmoi.stdin -}}
{{- else -}}
  {{- $merged | toPrettyJson -}}
{{- end -}}
