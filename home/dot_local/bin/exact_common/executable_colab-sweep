#!/usr/bin/env python3
"""Stop leaked or expired Google Colab runtimes.

Usage:
  colab-sweep [--dry-run] [--grace DURATION]
  colab-sweep lease NAME DURATION

A sweep lists every runtime assigned to the account and compares it with the
sessions the `colab` CLI records locally: `~/.config/colab-cli/sessions.json`
plus every `*.json` in `~/.config/colab-cli/states/` (use that directory for
`colab --config <file>` state files). An assigned runtime that no state file
records is an orphan. It is unassigned once it has been an orphan for the grace
period (default 30m, or `COLAB_SWEEP_GRACE`), which protects a session that
`colab new` is still creating.

`colab-sweep lease NAME DURATION` gives a recorded session an expiry, such as
`4h`; the next sweep after it stops the session with `colab stop`. Sessions
without a lease are only reported. `--dry-run` reports without acting or
writing any file. Sweep state and the action log live in
`$XDG_STATE_HOME/colab-sweep` (default `~/.local/state/colab-sweep`).

The sweep runs under the `colab` CLI's own interpreter, found through
`mise where pipx:google-colab-cli`. Any API or state error is logged and makes
the sweep exit with status 1.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

COLAB_CONFIG_DIR = Path.home() / ".config" / "colab-cli"
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
    / "colab-sweep"
)
DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def parse_duration(text: str) -> int:
    """Return the seconds in a duration such as `90m`, `4h`, or `1d`."""
    match = re.fullmatch(r"(\d+)([smhd])", text)
    if not match:
        raise argparse.ArgumentTypeError(f"invalid duration: {text!r}")

    return int(match.group(1)) * DURATION_UNITS[match.group(2)]


def state_files(config_dir: Path) -> list[Path]:
    """Return the default state file and every registered extra state file."""
    return [
        config_dir / "sessions.json",
        *sorted((config_dir / "states").glob("*.json")),
    ]


def read_sessions(path: Path) -> dict[str, str]:
    """Return `{session name: endpoint}` recorded in one `colab` state file.

    Unlike the CLI's own reader, a malformed file raises instead of reading as
    empty, so a corrupt file can never turn owned sessions into orphans.
    """
    if not path.exists():
        return {}

    content = path.read_text(encoding="utf-8")
    if not content.strip():
        return {}

    return {name: session["endpoint"] for name, session in json.loads(content).items()}


def due_orphans(
    assigned: list[str],
    owned: set[str],
    first_seen: dict[str, float],
    now: float,
    grace: int,
) -> tuple[list[str], dict[str, float]]:
    """Return the orphans past the grace period and the updated first-seen map."""
    seen = {e: first_seen.get(e, now) for e in assigned if e not in owned}
    return [e for e, t in seen.items() if now - t >= grace], seen


def log(message: str, logfile: Path | None) -> None:
    """Print one timestamped line and append it to `logfile` when given."""
    line = f"{datetime.now().astimezone().isoformat(timespec='seconds')} {message}"
    print(line, flush=True)
    if logfile is None:
        return

    logfile.parent.mkdir(parents=True, exist_ok=True)
    with logfile.open("a", encoding="utf-8") as f:
        f.write(line + "\n")


def write_json(path: Path, data: dict[str, float]) -> None:
    """Replace `path` with `data` atomically."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
    os.replace(tmp, path)


def lease(name: str, seconds: int) -> int:
    """Record that session `name` expires `seconds` from now."""
    if "/" in name or name.startswith("."):
        print(f"invalid session name: {name!r}", file=sys.stderr)
        return 2

    path = STATE_DIR / "leases" / name
    path.parent.mkdir(parents=True, exist_ok=True)
    expiry = int(time.time()) + seconds
    path.write_text(f"{expiry}\n", encoding="utf-8")
    print(
        f"lease {name} expires {datetime.fromtimestamp(expiry).astimezone().isoformat()}"
    )
    return 0


def reexec_under_colab_python() -> None:
    """Replace this process with the `colab` CLI's interpreter."""
    if os.environ.get("COLAB_SWEEP_REEXEC"):
        raise RuntimeError("colab_cli is not importable from the colab CLI interpreter")

    # Assumes the mise pipx backend layout `<install>/google-colab-cli/bin/python`.
    install = subprocess.run(
        ["mise", "where", "pipx:google-colab-cli"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    python = str(Path(install) / "google-colab-cli" / "bin" / "python")
    os.environ["COLAB_SWEEP_REEXEC"] = "1"
    os.execv(python, [python, __file__, *sys.argv[1:]])


def sweep(dry_run: bool, grace: int) -> int:
    """Stop expired leases and unassign orphans; return the exit status."""
    logfile = None if dry_run else STATE_DIR / "sweep.log"
    prefix = "dry-run: would " if dry_run else ""
    failed = False

    try:
        from colab_cli.common import state
    except ImportError:
        try:
            reexec_under_colab_python()
        except (OSError, RuntimeError, subprocess.CalledProcessError) as e:
            log(f"error: cannot start the colab CLI interpreter: {e!r}", logfile)
            return 1

    try:
        owners = {
            endpoint: (name, path)
            for path in state_files(COLAB_CONFIG_DIR)
            for name, endpoint in read_sessions(path).items()
        }
    except (OSError, ValueError, KeyError, AttributeError) as e:
        log(f"error: cannot read colab state files: {e!r}", logfile)
        return 1

    colab = str(Path(sys.executable).with_name("colab"))
    now = time.time()
    for lease_file in sorted((STATE_DIR / "leases").glob("*")):
        name = lease_file.name
        try:
            expiry = int(lease_file.read_text().strip())
        except (OSError, ValueError) as e:
            log(f"error: cannot read lease {lease_file}: {e!r}", logfile)
            failed = True
            continue

        if expiry > now:
            log(f"lease {name}: {int(expiry - now) // 60}m left", logfile)
            continue

        paths = [path for owner, path in owners.values() if owner == name]
        if not paths:
            log(
                f"lease {name}: expired, session not recorded; {prefix}remove lease",
                logfile,
            )
            if not dry_run:
                lease_file.unlink()
            continue

        stopped = True
        for path in paths:
            log(f"lease {name}: expired; {prefix}stop session ({path})", logfile)
            if dry_run:
                continue

            result = subprocess.run(
                [colab, "--config", str(path), "stop", "-s", name], check=False
            )
            if result.returncode != 0:
                log(f"error: colab stop -s {name} exited {result.returncode}", logfile)
                stopped = False
                failed = True

        if stopped and not dry_run:
            lease_file.unlink()

    try:
        assignments = state.client.list_assignments()
    except (Exception, SystemExit) as e:
        log(f"error: cannot list assignments: {e!r}", logfile)
        return 1

    first_seen_file = STATE_DIR / "state.json"
    try:
        first_seen = (
            json.loads(first_seen_file.read_text()) if first_seen_file.exists() else {}
        )
    except (OSError, ValueError) as e:
        log(f"error: cannot read {first_seen_file}: {e!r}", logfile)
        return 1

    due, seen = due_orphans(
        [a.endpoint for a in assignments], set(owners), first_seen, now, grace
    )
    for a in assignments:
        owner = owners.get(a.endpoint)
        if owner:
            log(f"owned {a.endpoint} ({a.accelerator.value}) session={owner[0]}", logfile)
        else:
            age = int(now - seen[a.endpoint]) // 60
            log(f"orphan {a.endpoint} ({a.accelerator.value}) orphaned {age}m", logfile)

    for endpoint in due:
        log(f"{prefix}unassign orphan {endpoint}", logfile)
        if dry_run:
            continue

        try:
            state.client.unassign(endpoint)
            del seen[endpoint]
        except (Exception, SystemExit) as e:
            log(f"error: unassign {endpoint} failed: {e!r}", logfile)
            failed = True

    if not dry_run:
        write_json(first_seen_file, seen)

    try:
        from colab_cli.consumption import format_consumption_status

        print(format_consumption_status(state.client.get_consumption_user_info()))
    except (Exception, SystemExit) as e:
        log(f"warning: cannot read compute-unit usage: {e!r}", logfile)

    return 1 if failed else 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["lease"]:
        parser = argparse.ArgumentParser(prog="colab-sweep lease")
        parser.add_argument("name")
        parser.add_argument("duration", type=parse_duration)
        args = parser.parse_args(argv[1:])
        return lease(args.name, args.duration)

    parser = argparse.ArgumentParser(
        prog="colab-sweep", description=__doc__.splitlines()[0]
    )
    parser.add_argument("--dry-run", action="store_true", help="report without acting")
    parser.add_argument(
        "--grace",
        type=parse_duration,
        default=parse_duration(os.environ.get("COLAB_SWEEP_GRACE", "30m")),
        help="orphan age before unassigning (default 30m, or COLAB_SWEEP_GRACE)",
    )
    args = parser.parse_args(argv)
    return sweep(args.dry_run, args.grace)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
