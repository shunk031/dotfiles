#!/usr/bin/env zsh

# @file home/dot_zshenv
# @brief Load private variables and minimal mise startup for every Zsh process.
# @description
#   Sources the private environment first, then exposes mise and its shims
#   without loading interactive plugins or prompt configuration.

_zshenv_private="${HOME}/.zshenv_private"
_zshenv_mise="${HOME}/.config/shell/mise.zsh"

if [[ -r "${_zshenv_private}" ]]; then
    source "${_zshenv_private}"
fi

if [[ -r "${_zshenv_mise}" ]]; then
    source "${_zshenv_mise}"
fi

unset _zshenv_mise _zshenv_private
