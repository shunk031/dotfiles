#!/usr/bin/env bash

# for mise shims
# shellcheck source=../../private_dot_config/exact_shell/mise.bash
if [ -f "${HOME%/}/.config/shell/mise.bash" ]; then
    source "${HOME%/}/.config/shell/mise.bash"
fi

if [ -r "${HOME%/}/.config/alias/private.bash" ]; then
    source "${HOME%/}/.config/alias/private.bash"
fi

case $- in
*i*)
    if [ "$TERM" != "dumb" ] && command -v zsh > /dev/null; then
        exec zsh
    fi
    ;;
esac
