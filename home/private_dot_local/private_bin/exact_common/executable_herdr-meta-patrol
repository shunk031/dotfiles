#!/usr/bin/env bash

# @file home/private_dot_local/private_bin/exact_common/executable_herdr-meta-patrol
# @brief Poll Herdr machines without an LLM and queue news for the meta agent.
# @description
#   Scans the local Herdr server and every enabled `herdr machine list` machine
#   for blocked agents, inbox tokens, leftover input in root agents'
#   input boxes, agents stopped by an API error, and finished or orphaned panes.
#   An agent of any status counts as stopped when the last
#   `HERDR_META_PATROL_ERROR_LINES` lines of its pane hold a Codex or Claude Code
#   error line about a retry limit, 429, rate limit, usage limit, spending limit,
#   budget, or quota, or a Codex `Reconnecting... N/M` status line with a retry
#   limit or 429 on it or the two lines below. Herdr can keep reporting such an
#   agent as working. A Claude Code error line that is still retrying is skipped. Each executable in
#   `HERDR_META_PATROL_FINDINGS_DIR` also runs once per patrol, and each line it
#   prints is treated as a finding. A working agent whose pane letters, in any
#   script and without its interrupt hint line, have not changed for
#   `HERDR_META_PATROL_STILL_SECONDS` is reported as having made no progress; the
#   first time each text was seen is kept in `still.tsv`. Findings go to `latest.txt`.
#   A root is an agent listed in `${XDG_STATE_HOME:-$HOME/.local/state}/meta/roots.tsv`
#   for its machine alias (`Local` for this machine); inbox tokens alone do not
#   define roots.
#   Lines whose normalized form is new since the previous run are appended as one
#   message to the queue of `herdr-meta-patrol-queue`, which the meta agent waits
#   on; nothing is typed into any pane, and nothing is queued when nothing is new.
#   Leftover input is re-reported after `HERDR_META_PATROL_REPEAT_SECONDS`.
#   State is saved only after the message is queued, so a failed append is retried
#   on the next run. After each run, acknowledged messages past their keep period
#   are trimmed, and a batch of messages left unread while no waiter runs raises
#   one Herdr notification.
#   Every `HERDR_META_PATROL_DIGEST_SECONDS`, a progress digest compares each
#   registered root's agent status, tab label, and inbox token with the previous
#   digest (`digest.tsv`) and sends one line per changed root; nothing is sent when
#   no root changed. The first digest only records a baseline. Roots on a machine
#   that could not be read keep their previous state. A digest that cannot be queued
#   is retried on the next run. The installed meta patrol skill handles a visible
#   meta usage limit once per episode, notifying the user and telling eligible
#   meta workers to hold periodic STATUS while waiting for review.
# @option HERDR_META_PATROL_META Name of the meta agent, which the scan skips (default `meta`).
# @option HERDR_META_PATROL_STATE_DIR State directory, shared with the queue (default `~/.local/state/herdr-meta-patrol`).
# @option HERDR_META_PATROL_QUEUE Queue command (default `herdr-meta-patrol-queue` next to this script).
# @option HERDR_META_PATROL_INPUT_PARSER Visible-input-state parser (default from the shunk031-herdr-orchestrate-workers skill).
# @option HERDR_META_PATROL_REPEAT_SECONDS Leftover re-report interval (default 3600).
# @option HERDR_META_PATROL_TIMEOUT Seconds before a single herdr call is killed (default 40).
# @option HERDR_META_PATROL_RETRY_SLEEP Seconds before the connection retry (default 5).
# @option HERDR_META_PATROL_DIGEST_SECONDS Progress digest interval (default 1800).
# @option HERDR_META_PATROL_ERROR_LINES Pane lines read per stopped-agent check (default 25).
# @option HERDR_META_PATROL_STILL_SECONDS Seconds without pane change before a working agent is reported (default 1200).
# @option HERDR_META_PATROL_FINDINGS_DIR Directory of finding scripts (default `~/.config/herdr-meta-patrol/findings.d`).
# @option HERDR_META_PATROL_FEED_COMMAND Inbox feed writer command (default the adjacent `herdr-meta-patrol-feed`).
# @option HERDR_META_PATROL_LIMIT_HANDLER Meta patrol script with the usage-limit handler (default from the installed meta skill).
# @option HERDR_META_PATROL_LIMIT_HOLD_TIMEOUT Seconds allowed for the limit handler and its child processes (default 90).

set -Eeuo pipefail

meta="${HERDR_META_PATROL_META:-meta}"
state_dir="${HERDR_META_PATROL_STATE_DIR:-${HOME}/.local/state/herdr-meta-patrol}"
roots_file="${XDG_STATE_HOME:-${HOME}/.local/state}/meta/roots.tsv"
queue_command="${HERDR_META_PATROL_QUEUE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/herdr-meta-patrol-queue}"
repeat_seconds="${HERDR_META_PATROL_REPEAT_SECONDS:-3600}"
timeout_seconds="${HERDR_META_PATROL_TIMEOUT:-40}"
retry_sleep="${HERDR_META_PATROL_RETRY_SLEEP:-5}"
digest_seconds="${HERDR_META_PATROL_DIGEST_SECONDS:-1800}"
error_lines="${HERDR_META_PATROL_ERROR_LINES:-25}"
still_seconds="${HERDR_META_PATROL_STILL_SECONDS:-1200}"
still_lines=40
findings_dir="${HERDR_META_PATROL_FINDINGS_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/herdr-meta-patrol/findings.d}"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${HERDR_META_PATROL_FEED_COMMAND:-}" ]]; then
    feed_command="${HERDR_META_PATROL_FEED_COMMAND}"
elif [[ -x "${script_dir}/herdr-meta-patrol-feed" ]]; then
    feed_command="${script_dir}/herdr-meta-patrol-feed"
else
    feed_command="${script_dir}/executable_herdr-meta-patrol-feed"
fi
limit_hold_handler="${HERDR_META_PATROL_LIMIT_HANDLER:-${HOME}/.agents/skills/shunk031-herdr-meta-orchestrate/scripts/herdr-meta-patrol.sh}"
limit_hold_timeout="${HERDR_META_PATROL_LIMIT_HOLD_TIMEOUT:-90}"
# Only lines shaped like an agent's own error output count: a Codex error cell
# starts with `■ ` at column 0, and a Claude Code API or usage-limit error is a
# `⎿` result line that starts with one of these phrases. Agents quote error
# texts, tool output, and file names that contain the same words in other lines.
api_error_line='^(■ |[[:space:]]*⎿[[:space:]]+(API Error|Claude usage limit|[0-9]+-hour limit|You.{1,3}ve hit your|Weekly limit|Session limit))'
# Codex shows this status line while it retries a failed request; a retry limit
# or 429 on it or the two lines below means the agent is stuck even while Herdr
# reports it as working.
api_reconnect_line='^[[:space:]]*[^[:alnum:][:space:]]+ Reconnecting\.\.\. [0-9]+/[0-9]+([[:space:]]+\(|[[:space:]]*$)'
# Error texts within those lines that end an agent's turn.
api_error_pattern='exceeded retry limit|429|Too Many Requests|rate[ _-]?limit|usage limit|hit your ([a-z]+ )?limit|limit reached|spend(ing)?[ _-]limit[ _-]exceeded|budget[ _-](exceeded|exhausted)|insufficient_quota|quota[ _-]exceeded'
machine=local
input_state_parser="${HERDR_META_PATROL_INPUT_PARSER:-${HOME}/.agents/skills/shunk031-herdr-orchestrate-workers/scripts/herdr-visible-input-state.awk}"

# @description Run a command in its own process group and terminate that group at the timeout.
# @arg $1 number Seconds before the process group is terminated.
# @arg $@ command Command and arguments to run.
function run_with_timeout() {
    local timeout="$1"
    shift
    perl -MPOSIX=setpgid -e '
        my $timeout = shift;
        my @command = @ARGV;
        my $pid = fork();
        defined($pid) or die "timeout fork: $!\n";
        if ($pid == 0) {
            setpgid(0, 0) == 0 or die "timeout process group: $!\n";
            exec { $command[0] } @command or die "timeout exec: $!\n";
        }
        setpgid($pid, $pid);
        local $SIG{ALRM} = sub {
            kill "TERM", -$pid;
            kill "TERM", $pid;
            sleep 1;
            kill "KILL", -$pid;
            kill "KILL", $pid;
            exit 124;
        };
        alarm $timeout;
        waitpid($pid, 0);
        my $status = $?;
        alarm 0;
        die "timeout wait: $!\n" if $status == -1;
        exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
    ' "$timeout" "$@"
}

# @description Run herdr with an independent timeout for this call.
# @arg $@ command Herdr subcommand and arguments.
function hx() {
    run_with_timeout "${timeout_seconds}" herdr "$@"
}

# @description Run herdr against the machine being scanned.
function hr() {
    if [[ "${machine}" == local ]]; then
        hx "$@"
    else
        hx --machine "${machine}" "$@"
    fi
}

# @description Drop the oldest lines of a log that grew past 1000 lines.
# @arg $1 string Log file path.
function trim_log() {
    [[ -f "$1" ]] && (($(wc -l < "$1") > 1000)) && {
        tail -n 500 "$1" > "$1.tmp"
        cat "$1.tmp" > "$1"
        rm -f "$1.tmp"
    }
    return 0
}

# @description Return whether an agent is listed as a root for this machine.
# @arg $1 string Machine alias from the roots registry.
# @arg $2 string Agent name.
function is_registered_root() {
    [[ -r "${roots_file}" ]] && awk -F '\t' -v machine="$1" -v name="$2" \
        '$0 !~ /^#/ && NF == 2 && $1 == machine && $2 == name { found = 1 } END { exit !found }' \
        "${roots_file}"
}

# @description Log a failed `agent list` attempt's exit status to stderr, which launchd writes to launchd.log.
# @arg $1 number Exit status of the failed attempt.
function log_attempt_failure() {
    printf '[%s] [%s] agent list failed (exit %s)\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${machine}" "$1" >&2
}

# @description Write one digest record per registered root on a machine.
# @arg $1 string Machine label used in messages (`local` for this machine).
# @arg $2 string Machine alias from the roots registry.
# @arg $3 string JSON output of `herdr agent list` for the machine.
# @arg $4 string Digest record file; it is created only when the records are complete.
# @arg $5 string JSON output of `herdr tab list` for the machine.
function write_digest_records() {
    local machine="$1" registry_machine="$2" list="$3" digest_file="$4" tabs="$5" roots records
    roots="$(
        if [[ -r "${roots_file}" ]]; then
            LC_ALL=C awk -F '\t' -v machine="${registry_machine}" \
                '$0 !~ /^#/ && NF == 2 && $1 == machine { print $2 }' "${roots_file}"
        fi | jq -R . | jq -sc --arg meta "${meta}" 'unique - [$meta]'
    )" || return 0
    if [[ "${roots}" == '[]' ]]; then
        : > "${digest_file}"
        return 0
    fi
    records="$(jq -r --arg m "${machine}" --argjson roots "${roots}" --argjson tabs "${tabs}" '
        ([$tabs.result.tabs[]? | {key: .tab_id, value: (.label // "")}] | from_entries) as $labels
        | .result.agents as $agents
        | $roots[] as $root
        | ([$agents[] | select(.name == $root)] | .[0]) as $agent
        | if $agent == null then [$m, $root, "不在", "-", "-"]
          else [$m, $root, ($agent.agent_status // "-"),
              ($labels[$agent.tab_id // ""] // "-"), ($agent.tokens.inbox // "-" | tostring)]
          end
        | map(if . == "" then "-" else gsub("[\t\r\n]"; " ") end) | join("\t")
    ' <<< "${list}" 2> /dev/null)" || return 0
    if [[ -n "${records}" ]]; then
        printf '%s\n' "${records}" > "${digest_file}"
    else
        : > "${digest_file}"
    fi
}

# @description Print why a pane's text shows an agent stopped by an API error, or nothing.
# @stdin Recent pane text.
function api_error_cause() {
    local text matched cause suffix=""
    text="$(cat)"
    # A Claude Code line that is still retrying has not stopped the agent yet.
    matched="$(LC_ALL=C grep -E -- "${api_error_line}" <<< "${text}" | LC_ALL=C grep -v -- 'Retrying in' | LC_ALL=C grep -iE -- "${api_error_pattern}")" || matched=""
    if [[ -z "${matched}" ]]; then
        matched="$(R="${api_reconnect_line}" LC_ALL=C awk '$0 ~ ENVIRON["R"] { n = 3 } n > 0 { print; n-- }' <<< "${text}" | LC_ALL=C grep -iE -- 'exceeded retry limit|429|Too Many Requests')" || matched=""
    fi
    [[ -n "${matched}" ]] || return 0
    if LC_ALL=C grep -qiE -- '429|Too Many Requests' <<< "${matched}"; then
        cause='429 '
    elif LC_ALL=C grep -qiE -- 'usage limit|hit your|limit reached' <<< "${matched}"; then
        cause=利用上限
    else
        cause='API 制限'
    fi
    if LC_ALL=C grep -qiE -- 'spend(ing)?[ _-]limit|budget' <<< "${matched}"; then suffix='（Gateway 予算）'; fi
    printf '%sで停止%s\n' "${cause}" "${suffix}"
}

# @description Print a checksum of the letters in pane text, ignoring timers, spinners, and the interrupt hint.
# @stdin Recent pane text.
function pane_progress_sum() {
    local letters
    letters="$(perl -CSD -ne 'next if /esc to interrupt|interrupt\)/i; s/[^\p{L}\n]//g; print')"
    # An empty or fully filtered pane gives no evidence either way.
    [[ -n "${letters//$'\n'/}" ]] || return 1
    printf '%s\n' "${letters}" | cksum | awk '{ print $1 }'
}

# @description Print the findings for the current `machine`, one per line.
# @arg $1 string Machine label (`local` for this machine).
# @arg $2 string Digest record file, or empty when no digest is due.
# @arg $3 string File for this machine's `still.tsv` records; it is created only when the agent list was read.
# @arg $4 path Prefix for this machine's agent and tab JSON snapshots.
function scan_machine() {
    local machine="$1" digest_file="$2" still_file="$3" snapshot_prefix="$4" registry_machine list tabs agent a pane inbox relay refs input_state has_inbox registered status fin del panes cause label sum since
    list="$(hr agent list 2> /dev/null)" || {
        log_attempt_failure "$?"
        sleep "${retry_sleep}"
        list="$(hr agent list 2> /dev/null)" || {
            log_attempt_failure "$?"
            printf '[%s] 接続できない（2 回とも失敗）\n' "${machine}"
            return 0
        }
    }
    printf '%s\n' "${list}" > "${snapshot_prefix}.agents.json"
    tabs=""
    if tabs="$(hr tab list 2> /dev/null)" && jq -e '.result.tabs | type == "array"' <<< "${tabs}" > /dev/null 2>&1; then
        printf '%s\n' "${tabs}" > "${snapshot_prefix}.tabs.json"
    else
        tabs=""
    fi
    jq -r --arg m "${machine}" --arg meta "${meta}" '.result.agents[] | select(.agent_status=="blocked") | select((.name // "") != $meta) | "[\($m)] blocked: \(.name // "-") \(.pane_id)"' <<< "${list}"
    if [[ "${machine}" == local ]]; then registry_machine=Local; else registry_machine="${machine}"; fi
    : > "${still_file}"
    if [[ -n "${digest_file}" ]]; then
        write_digest_records "${machine}" "${registry_machine}" "${list}" "${digest_file}" "${tabs}"
    fi
    fin=0
    while IFS= read -r agent; do
        a="$(jq -r '.name // "-"' <<< "${agent}")"
        [[ "${a}" != "${meta}" ]] || continue
        pane="$(jq -r '.pane_id // empty' <<< "${agent}")"
        inbox="$(jq -r '.tokens.inbox // empty' <<< "${agent}")"
        has_inbox="$(jq -r '(.tokens // {}) | has("inbox")' <<< "${agent}")"
        status="$(jq -r '.agent_status // empty' <<< "${agent}")"
        if [[ -n "${pane}" && "${status}" == working ]]; then
            if sum="$(hr pane read "${pane}" --source recent --lines "${still_lines}" --format text 2> /dev/null | pane_progress_sum)"; then
                since="$(M="${machine}" P="${pane}" S="${sum}" awk -F '\t' '$1 == ENVIRON["M"] && $2 == ENVIRON["P"] && $3 == ENVIRON["S"] { print $4; exit }' "${state_dir}/still.tsv")"
                [[ -n "${since}" ]] || since="${now}"
                printf '%s\t%s\t%s\t%s\n' "${machine}" "${pane}" "${sum}" "${since}" >> "${still_file}"
                if ((now - since >= still_seconds)); then
                    if [[ "${a}" == - ]]; then label="${pane}"; else label="${a}"; fi
                    printf '[%s] %s: %s 分動きなし\n' "${machine}" "${label}" "$((still_seconds / 60))"
                fi
            fi
        fi
        if [[ -n "${pane}" ]]; then
            cause="$(hr pane read "${pane}" --source recent --lines "${error_lines}" --format text 2> /dev/null | api_error_cause)" || cause=""
            if [[ -n "${cause}" ]]; then
                if [[ "${a}" == - ]]; then label="${pane}"; else label="${a}"; fi
                printf '[%s] %s: %s\n' "${machine}" "${label}" "${cause}"
            fi
        fi
        registered=0
        if is_registered_root "${registry_machine}" "${a}"; then registered=1; fi
        if [[ "${registered}" == 1 ]]; then
            relay="$(jq -r '.tokens.relay // empty' <<< "${agent}")"
            refs=""
            if [[ -n "${relay}" ]]; then refs+=" relay=${relay}"; fi
            if jq -e '(.tokens.url // "") | length > 0' <<< "${agent}" > /dev/null; then
                refs+=" url=present"
            fi
            if [[ -n "${inbox}" && "${inbox}" != 0 ]]; then
                printf '[%s] %s inbox=%s%s\n' "${machine}" "${a}" "${inbox}" "${refs}"
            fi
            if [[ -n "${pane}" && -r "${input_state_parser}" ]]; then
                input_state="$(hr pane read "${pane}" --source visible --format ansi 2> /dev/null | LC_ALL=C awk -f "${input_state_parser}" 2> /dev/null)" || input_state=unknown
                if [[ "${input_state}" == occupied ]]; then
                    printf '[%s] %s 入力欄: occupied\n' "${machine}" "${a}"
                fi
            fi
        elif [[ "${has_inbox}" == true ]]; then
            printf '[%s] unregistered agent with inbox token: %s\n' "${machine}" "${a}"
        fi
        if [[ "${status}" == "done" || "${status}" == idle ]] && [[ "${registered}" == 0 ]]; then
            fin=$((fin + 1))
        fi
    done < <(jq -c '.result.agents[]' <<< "${list}")
    panes="$(hr pane list 2> /dev/null)" || panes='{}'
    del="$(jq -r '[.result.panes[]? | select(((.cwd // "") + (.foreground_cwd // "")) | test("\\(deleted\\)"))] | length' <<< "${panes}")" || del=0
    [[ "${fin}" != 0 ]] && printf '[%s] 残り: 終わった・待機中の作業役 %s 個\n' "${machine}" "${fin}"
    [[ "${del:-0}" != 0 ]] && printf '[%s] 残り: 中身が消えたペイン %s 個\n' "${machine}" "${del}"
    return 0
}

# @description Strip the per-run counts so an unchanged situation yields an identical line.
function normalize() {
    sed -E 's/^(\[[^]]*\] [^ ]+ inbox=)[0-9]+ · /\1N · /; s/^(\[[^]]*\] 残り: .* )[0-9]+ 個$/\1N 個/'
}

# @description Print the epoch recorded for a leftover line, or nothing.
# @arg $1 string Leftover line.
function leftover_epoch() {
    L="$1" awk -F'\t' '$2 == ENVIRON["L"] { print $1; exit }' "${state_dir}/leftover.tsv"
}

# @description Print one line per root whose digest record changed, listing each changed field.
#   Comparison runs under the C locale: macOS awk compares strings by collation in a
#   UTF-8 locale, where different emoji in a tab label can compare equal.
# @arg $1 string Previous digest file.
# @arg $2 string Current digest file.
function digest_changes() {
    LC_ALL=C awk -F '\t' '
        FILENAME == ARGV[1] { key = $1 FS $2; st[key] = $3; tb[key] = $4; ib[key] = $5; seen[key] = 1; next }
        {
            key = $1 FS $2
            if (!(key in seen)) { st[key] = "-"; tb[key] = "-"; ib[key] = "-" }
            out = ""
            if (st[key] != $3) out = out (out == "" ? "" : " / ") "状態 " st[key] " → " $3
            if (tb[key] != $4) out = out (out == "" ? "" : " / ") "タブ " tb[key] " → " $4
            if (ib[key] != $5) out = out (out == "" ? "" : " / ") "inbox " ib[key] " → " $5
            # A root that left the agent list has no tab or inbox to compare.
            if ($3 == "不在" && st[key] != $3) out = "状態 " st[key] " → " $3
            if (out != "") printf "[%s] %s: %s\n", $1, $2, out
        }
    ' "$1" "$2"
}

mkdir -p "${state_dir}"
touch "${state_dir}/keys.txt" "${state_dir}/leftover.tsv" "${state_dir}/still.tsv"
now="$(date +%s)"
last_digest="$(cat "${state_dir}/digest.epoch" 2> /dev/null)" || last_digest=""
digest_due=0
if [[ ! "${last_digest}" =~ ^[0-9]+$ ]] || ((now - last_digest >= digest_seconds)); then
    digest_due=1
fi

findings=""
trim_log "${state_dir}/launchd.log"
machine_list_succeeded=0
if machine_list="$(hx machine list --json 2> /dev/null | jq -r '.[] | select(.enabled) | .label')"; then
    machine_list_succeeded=1
else
    machine_list=""
fi
machines=(local)
while IFS= read -r machine_label; do
    if [[ -n "${machine_label}" ]]; then machines+=("${machine_label}"); fi
done <<< "${machine_list}"
scan_dir="$(mktemp -d "${state_dir}/scan.XXXXXX")"
trap 'rm -rf "$scan_dir"' EXIT
pids=()
for ((i = 0; i < ${#machines[@]}; i++)); do
    digest_file=""
    ((digest_due == 0)) || digest_file="${scan_dir}/${i}.digest"
    (scan_machine "${machines[$i]}" "${digest_file}" "${scan_dir}/${i}.still" "${scan_dir}/${i}") > "${scan_dir}/${i}.out" &
    pids[i]=$!
done
scan_failed=0
for pid in "${pids[@]}"; do
    if ! wait "${pid}"; then scan_failed=1; fi
done
((scan_failed == 0)) || exit 1
for ((i = 0; i < ${#machines[@]}; i++)); do
    findings+="$(cat "${scan_dir}/${i}.out")"$'\n'
done
if [[ -d "${findings_dir}" ]]; then
    for script in "${findings_dir}"/*; do
        [[ -f "${script}" && -x "${script}" ]] || continue
        if script_output="$(perl -e 'alarm shift; exec @ARGV' "${timeout_seconds}" "${script}" 2> /dev/null)"; then
            findings+="$(tr -d '\r' <<< "${script_output}")"$'\n'
        else
            printf '[%s] finding script failed: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${script##*/}" >&2
        fi
    done
fi

new=""
keys=""
leftovers=""
leftover_tsv=""
while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    if [[ "${line}" == *' 入力欄: '* ]]; then
        leftovers+="${line}"$'\n'
        epoch="$(leftover_epoch "${line}")"
        if [[ -z "${epoch}" ]] || ((now - epoch >= repeat_seconds)); then
            new+="${line}"$'\n'
            epoch="${now}"
        fi
        leftover_tsv+="${epoch}"$'\t'"${line}"$'\n'
        continue
    fi
    key="$(normalize <<< "${line}")"
    keys+="${key}"$'\n'
    grep -qxF -- "${key}" "${state_dir}/keys.txt" || new+="${line}"$'\n'
done <<< "${findings}"

# A machine that was failing and now is not gets a one-time recovery line.
while IFS= read -r key; do
    [[ "${key}" == *接続できない* ]] || continue
    grep -qxF -- "${key}" <<< "${keys}" || new+="${key%% *} 接続が回復した"$'\n'
done < "${state_dir}/keys.txt"

# @description Persist this run's state; called only once the message is queued.
function commit_state() {
    printf '%s' "${keys}" > "${state_dir}/keys.txt"
    printf '%s' "${leftover_tsv}" > "${state_dir}/leftover.tsv"
}

# @description Append one message to the meta queue.
# @arg $1 string Message kind.
# @arg $2 string Message text.
function queue_message() {
    HERDR_META_PATROL_STATE_DIR="${state_dir}" "${queue_command}" add --kind "$1" --from patrol "$2" || {
        printf '[%s] queue append failed (%s)\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >&2
        return 1
    }
}

# @description Persist this run's digest as the baseline for the next one.
# @arg $1 string Current digest file.
function commit_digest() {
    cat "$1" > "${state_dir}/digest.tsv"
    printf '%s\n' "${now}" > "${state_dir}/digest.epoch"
}

# @description Queue the progress digest when a registered root changed since the last digest.
function send_digest() {
    local current="${scan_dir}/digest.current" changes message i scanned
    : > "${current}"
    scanned=""
    for ((i = 0; i < ${#machines[@]}; i++)); do
        if [[ -e "${scan_dir}/${i}.digest" ]]; then
            cat "${scan_dir}/${i}.digest" >> "${current}"
            scanned+="${machines[$i]}"$'\n'
        fi
    done
    if [[ -e "${state_dir}/digest.tsv" ]]; then
        # Roots on a machine that could not be read keep their previous state. This
        # includes a machine no longer listed, whose records then stay unchanged.
        S="${scanned}" LC_ALL=C awk -F '\t' '
            BEGIN { n = split(ENVIRON["S"], list, "\n"); for (j = 1; j <= n; j++) ok[list[j]] = 1 }
            !($1 in ok)
        ' "${state_dir}/digest.tsv" >> "${current}"
    else
        commit_digest "${current}"
        return 0
    fi
    changes="$(digest_changes "${state_dir}/digest.tsv" "${current}")"
    if [[ -z "${changes}" ]]; then
        commit_digest "${current}"
        return 0
    fi
    message="$(printf '進捗まとめ（自動巡回）\n%s' "${changes}")"
    if queue_message digest "${message}"; then
        commit_digest "${current}"
    fi
}

# Panes on a machine that could not be read keep their first-seen times.
still_scanned=""
: > "${scan_dir}/still.next"
for ((i = 0; i < ${#machines[@]}; i++)); do
    if [[ -e "${scan_dir}/${i}.still" ]]; then
        cat "${scan_dir}/${i}.still" >> "${scan_dir}/still.next"
        still_scanned+="${machines[$i]}"$'\n'
    fi
done
S="${still_scanned}" LC_ALL=C awk -F '\t' '
    BEGIN { n = split(ENVIRON["S"], list, "\n"); for (j = 1; j <= n; j++) ok[list[j]] = 1 }
    !($1 in ok)
' "${state_dir}/still.tsv" >> "${scan_dir}/still.next"
cat "${scan_dir}/still.next" > "${state_dir}/still.tsv"

printf '%s' "${findings}" > "${state_dir}/latest.txt"
machine=local

if [[ -z "${new}" ]]; then
    commit_state
else
    message="$(printf '自動巡回（herdr-meta-patrol）で新しい項目を検出しました。\n%s' "${new}")"
    if queue_message findings "${message}"; then
        commit_state
    fi
fi

if ((digest_due)); then
    send_digest
fi

if [[ -x "${limit_hold_handler}" ]]; then
    if ! run_with_timeout "${limit_hold_timeout}" env \
        HERDR_ENV=1 HERDR_META_PATROL_META="${meta}" HERDR_META_PATROL_STATE_DIR="${state_dir}" \
        HERDR_META_PATROL_CALL_TIMEOUT="${timeout_seconds}" "${limit_hold_handler}" --limit-hold; then
        printf '[%s] meta usage-limit handler failed\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >&2
    fi
else
    printf '[%s] meta usage-limit handler is not installed: %s\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${limit_hold_handler}" >&2
fi

HERDR_META_PATROL_STATE_DIR="${state_dir}" "${queue_command}" trim || true
HERDR_META_PATROL_STATE_DIR="${state_dir}" "${queue_command}" notify-if-stale || true

# Feed snapshots are written after patrol state and the queue have been handled.
feed_options=()
feed_args=()
for ((i = 0; i < ${#machines[@]}; i++)); do
    if [[ -s "${scan_dir}/${i}.agents.json" && -s "${scan_dir}/${i}.tabs.json" ]]; then
        feed_args+=("${machines[$i]}" "${scan_dir}/${i}.agents.json" "${scan_dir}/${i}.tabs.json")
    else
        feed_args+=("${machines[$i]}" "" "")
    fi
done
((machine_list_succeeded == 0)) || feed_options+=(--prune)
if ! "${feed_command}" ${feed_options[@]+"${feed_options[@]}"} "${feed_args[@]}"; then
    printf '[%s] inbox feed writer failed\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >&2
fi
