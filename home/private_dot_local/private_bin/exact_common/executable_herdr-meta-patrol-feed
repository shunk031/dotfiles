#!/usr/bin/env bash

# @file home/private_dot_local/private_bin/exact_common/executable_herdr-meta-patrol-feed
# @brief Write Herdr root snapshots to Inbox feed files.
# @description
#   Reads one agent-list and tab-list snapshot per machine and writes one
#   atomic feed file per machine. Registered roots get an entry when working,
#   blocked, with a positive integer `inbox-needs-you` count, or with an active
#   `inbox-stop` token. The `inbox` token is entry detail only. An included
#   inactive root maps to `done`; a stop marks it `blocked`. Missing or invalid
#   snapshots carry forward the previous entries and add a blocked machine entry.
# @option --prune Remove feed files for machines absent from the supplied snapshots.
# @option HERDR_META_PATROL_FEED_DIR Feed directory (default `~/.local/state/inbox/feeds`).
# @arg $1 string Repeated triples of machine alias, agent-list JSON path, and tab-list JSON path.
# @example
#   herdr-meta-patrol-feed --prune local agents.json tabs.json remote remote-agents.json remote-tabs.json

set -Eeuo pipefail
umask 077

feed_dir="${HERDR_META_PATROL_FEED_DIR:-${HOME}/.local/state/inbox/feeds}"
active_items_file="${feed_dir}/meta-open-items.json"
roots_file="${XDG_STATE_HOME:-${HOME}/.local/state}/meta/roots.tsv"
meta="${HERDR_META_PATROL_META:-meta}"
now_ms="$(($(date +%s) * 1000))"
prune=0
scanned_machines=""
failed=0

# @description Print usage for the feed writer.
function usage() {
    printf 'Usage: herdr-meta-patrol-feed [--prune] <machine> <agent-json> <tab-json> [<machine> <agent-json> <tab-json> ...]\n' >&2
    exit 2
}

# @description Return whether a machine-root pair is in the roots registry.
# @arg $1 string Machine alias, using `Local` for this machine.
# @arg $2 string Agent name.
function is_registered_root() {
    [[ -r "${roots_file}" ]] && LC_ALL=C awk -F '\t' -v machine="$1" -v name="$2" \
        '$0 !~ /^#/ && NF == 2 && $1 == machine && $2 == name { found = 1 } END { exit !found }' \
        "${roots_file}"
}

# @description Append one compact JSON entry to the current entry array.
# @arg $1 string JSON object to append.
function append_entry() {
    entries_json="$(jq -cn --argjson entries "${entries_json}" --argjson entry "$1" '$entries + [$entry]')"
}

# @description Append one warning to the current untracked-work array.
# @arg $1 string JSON warning object to append.
function append_warning() {
    warnings_json="$(jq -cn --argjson warnings "${warnings_json}" --argjson warning "$1" '$warnings + [$warning]')"
}

# @description Add one feed entry for a registered root agent.
# @arg $1 string Machine alias.
# @arg $2 string Root agent name.
# @arg $3 JSON Root agent object.
function append_root_entry() {
    local machine="$1" root="$2" agent="$3" state stop detail needs_you key entry
    state="$(jq -r '.agent_status // empty' <<< "${agent}")"
    stop="$(jq -r '.tokens["inbox-stop"] // "" | tostring' <<< "${agent}")"
    detail="$(jq -r '.tokens.inbox // "" | tostring' <<< "${agent}")"
    needs_you="$(jq -r '
        ((.tokens["inbox-needs-you"] // "0") | tonumber? // 0) as $count
        | if $count > 0 and ($count | floor) == $count then "true" else "false" end
    ' <<< "${agent}")"
    if [[ -n "${stop}" && "${stop}" != 0 ]]; then
        state=blocked
    elif [[ "${state}" == idle ]]; then
        state='done'
    fi
    case "${state}" in
    working | blocked) ;;
    *)
        [[ "${needs_you}" == true ]] || return 0
        state='done'
        ;;
    esac

    key="herdr/${machine}/root/${root}"
    if key_exceeds_limit "${key}"; then
        printf 'feed key exceeds 100 bytes for root %s on %s\n' "${root}" "${machine}" >&2
        return 0
    fi
    entry="$(jq -cn --arg key "${key}" --arg state "${state}" --arg title "${root}: ${state}" --arg detail "${detail}" \
        '{key:$key,state:$state,title:($title[:120]),detail:($detail[:600])}')"
    append_entry "${entry}"
}

# @description Return the count of open items owned by an agent in the active-items file.
# @arg $1 string Machine label.
# @arg $2 string Agent name.
# @arg $3 string Item kind, `task` or `work`.
function tracked_count() {
    local machine="$1" agent="$2" kind="$3" signal="${4:-}"
    [[ -r "${active_items_file}" ]] || {
        printf '0\n'
        return
    }
    jq -r --arg machine "${machine}" --arg agent "${agent}" --arg kind "${kind}" --arg signal "${signal}" '
        if .source != "meta-open-items" or (.entries | type) != "array" then 0
        else [.entries[] | select(.kind == $kind and .state != "done" and ((.owner.machine == $machine and .owner.agent == $agent) or (.signalKey == $signal and $signal != "")))] | length
        end
    ' "${active_items_file}" 2> /dev/null || printf '0\n'
}

# @description Add a warning when a root has more live user asks than tracked tasks.
# @arg $1 string Machine label.
# @arg $2 string Root agent name.
# @arg $3 JSON Root agent object.
function check_root_asks() {
    local machine="$1" root="$2" agent="$3" count tracked missing key warning label
    count="$(jq -r '(.tokens["inbox-needs-you"] // "0") | tonumber? // 0' <<< "${agent}")"
    ((count > 0)) || return 0
    label="${machine}"
    [[ -n "${label}" ]] || label=local
    key="herdr/${label}/${root}/untracked-asks"
    tracked="$(tracked_count "${machine}" "${root}" task "${key}")"
    missing=$((count - tracked))
    ((missing > 0)) || return 0
    if key_exceeds_limit "${key}"; then
        printf 'warning key exceeds 100 bytes for root %s\n' "${root}" >&2
        return 0
    fi
    warning="$(jq -cn --arg key "${key}" --arg title "${root}: user asks" --arg detail "${missing} of ${count} asks have no open task on ${label}" \
        '{key:$key,title:($title[:120]),detail:($detail[:600])}')"
    append_warning "${warning}"
}

# @description Add a warning when a live meta-prefixed agent has no open work item.
# @arg $1 string Machine label.
# @arg $2 JSON Agent object.
function check_meta_worker() {
    local machine="$1" agent="$2" name state label key warning
    name="$(jq -r '.name // empty' <<< "${agent}")"
    state="$(jq -r '.agent_status // empty' <<< "${agent}")"
    [[ "${name}" == meta-* && ("${state}" == working || "${state}" == blocked) ]] || return 0
    label="${machine}"
    [[ -n "${label}" ]] || label=local
    key="herdr/${label}/${name}/untracked-work"
    [[ "$(tracked_count "${machine}" "${name}" work "${key}")" -gt 0 ]] && return 0
    if key_exceeds_limit "${key}"; then
        printf 'warning key exceeds 100 bytes for agent %s\n' "${name}" >&2
        return 0
    fi
    warning="$(jq -cn --arg key "${key}" --arg title "${name}" --arg detail "${state} agent has no open work item on ${label}" \
        '{key:$key,title:($title[:120]),detail:($detail[:600])}')"
    append_warning "${warning}"
}

# @description Return whether a feed key exceeds the Inbox byte limit.
# @arg $1 string Feed key.
function key_exceeds_limit() {
    local key="$1" byte_count
    byte_count="$(LC_ALL=C printf '%s' "${key}" | wc -c | tr -d '[:space:]')"
    ((byte_count > 100))
}

# @description Build registered-root entries and untracked-work warnings from a successful snapshot.
# @arg $1 string Machine alias.
# @arg $2 path Agent-list JSON snapshot.
function build_reachable_entries() {
    local machine="$1" agents_file="$2" registry_machine root agent name
    entries_json='[]'
    warnings_json='[]'
    if [[ "${machine}" == local ]]; then registry_machine=Local; else registry_machine="${machine}"; fi

    if [[ -r "${roots_file}" ]]; then
        while IFS=$'\t' read -r root; do
            [[ -n "${root}" && "${root}" != "${meta}" ]] || continue
            agent="$(jq -c --arg name "${root}" '[.result.agents[]? | select(.name == $name)][0] // empty' "${agents_file}")"
            [[ -n "${agent}" ]] || continue
            append_root_entry "${machine}" "${root}" "${agent}"
            check_root_asks "${machine}" "${root}" "${agent}"
        done < <(LC_ALL=C awk -F '\t' -v machine="${registry_machine}" \
            '$0 !~ /^#/ && NF == 2 && $1 == machine && !seen[$2]++ { print $2 }' "${roots_file}" 2> /dev/null)
    fi

    agent="$(jq -c --arg name "${meta}" '[.result.agents[]? | select(.name == $name)][0] // empty' "${agents_file}")"
    if [[ -n "${agent}" ]]; then
        if is_registered_root "${registry_machine}" "${meta}"; then
            append_root_entry "${machine}" "${meta}" "${agent}"
        fi
        check_root_asks "${machine}" "${meta}" "${agent}"
    fi

    while IFS= read -r agent; do
        name="$(jq -r '.name // empty' <<< "${agent}")"
        [[ -n "${name}" ]] || continue
        if [[ "${name}" == meta-* ]]; then
            check_meta_worker "${machine}" "${agent}"
        fi
    done < <(jq -c '.result.agents[]?' "${agents_file}")
}

# @description Finish a feed document, retaining timestamps for unchanged entries and warnings.
# @arg $1 string Desired entry array.
# @arg $2 string Previous feed document.
# @arg $3 string Whether carried entries keep their old timestamps.
# @arg $4 string Machine entry key.
# @arg $5 string Desired untracked-work warning array.
# @stdout Compact feed document.
function finish_feed() {
    jq -cn --argjson desired "$1" --argjson old "$2" --argjson now "${now_ms}" \
        --argjson carry_at "$3" --arg machine_key "$4" --argjson desired_warnings "$5" '
        ($old.entries // [] | map({key, value: .}) | from_entries) as $previous
        | ($desired | map(
            . as $entry
            | ($previous[$entry.key] // null) as $prior
            | (if ($carry_at and $entry.key != $machine_key and ($entry.at | type == "number")) then $entry.at
               elif $prior != null
                   and $prior.state == $entry.state
                   and $prior.title == $entry.title
                   and $prior.detail == $entry.detail
                   and (($now - $prior.at) >= 0)
                   and (($now - $prior.at) < 3600000)
               then $prior.at
               else $now
               end) as $at
            | . + {at: $at}
        ) | sort_by((if .state == "blocked" then 0 elif .state == "working" then 1 else 2 end), .key) | .[:40]) as $entries
        | ($old.warnings // [] | map({key, value: .}) | from_entries) as $previous_warnings
        | ($desired_warnings | map(
            . as $warning
            | ($previous_warnings[$warning.key] // null) as $prior
            | (if $prior != null and $prior.title == $warning.title and $prior.detail == $warning.detail then $prior.at else $now end) as $at
            | . + {at: $at}
        ) | sort_by(.key)) as $warnings
        | {
            version: 1,
            source: "herdr-meta-patrol",
            writtenAt: (if $entries == ($old.entries // []) and $warnings == ($old.warnings // []) then ($old.writtenAt // $now) else $now end),
            entries: $entries,
            warnings: $warnings
        }
    '
}

# @description Load a previous feed when its basic structure is valid.
# @arg $1 path Feed file.
# @stdout Previous feed or an empty feed document.
function load_previous() {
    local path="$1"
    if [[ -r "${path}" ]] && jq -e '
        .version == 1 and (.source | type == "string") and (.writtenAt | type == "number") and (.entries | type == "array")
    ' "${path}" > /dev/null 2>&1; then
        jq -c '{version,source,writtenAt,entries,warnings:(.warnings // [])}' "${path}"
    else
        printf '%s\n' '{"version":1,"source":"herdr-meta-patrol","writtenAt":0,"entries":[],"warnings":[]}'
    fi
}

# @description Write the feed atomically unless its bytes already match.
# @arg $1 path Destination file.
# @arg $2 string Compact feed document.
function write_atomic() {
    local target="$1" content="$2" temp
    temp="$(mktemp "${feed_dir}/.tmp.XXXXXX")" || return 1
    if ! printf '%s\n' "${content}" > "${temp}"; then
        rm -f "${temp}"
        return 1
    fi
    if cmp -s "${temp}" "${target}"; then
        rm -f "${temp}"
        return 0
    fi
    if ! mv -f "${temp}" "${target}"; then
        rm -f "${temp}"
        return 1
    fi
}

# @description Write one reachable machine's feed, or carry its previous entries forward when snapshots are invalid.
# @arg $1 string Machine alias.
# @arg $2 path Agent-list JSON snapshot, or a missing path.
# @arg $3 path Tab-list JSON snapshot, or a missing path.
function write_machine() {
    local machine="$1" agents_file="$2" tabs_file="$3" target machine_key previous entries_json warnings_json machine_detail machine_entry feed
    [[ -n "${machine}" && "${machine}" != *'/'* && "${machine}" != *$'\n'* ]] || {
        printf 'invalid Herdr machine alias for feed file\n' >&2
        return 1
    }
    target="${feed_dir}/herdr-${machine}.json"
    machine_key="herdr/${machine}/_machine"
    previous="$(load_previous "${target}")"

    if [[ -r "${agents_file}" && -r "${tabs_file}" ]] &&
        jq -e '.result.agents | type == "array"' "${agents_file}" > /dev/null 2>&1 &&
        jq -e '.result.tabs | type == "array"' "${tabs_file}" > /dev/null 2>&1; then
        if ! build_reachable_entries "${machine}" "${agents_file}"; then
            return 1
        fi
        feed="$(finish_feed "${entries_json}" "${previous}" false "${machine_key}" "${warnings_json}")" || return 1
    else
        machine_detail="$(jq -r --arg key "${machine_key}" '[.entries[]? | select(.key == $key)][0].detail // ""' <<< "${previous}")"
        if [[ ! "${machine_detail}" =~ ^unreachable[[:space:]]since[[:space:]][0-9]{2}:[0-9]{2}$ ]]; then
            machine_detail="unreachable since $(date +%H:%M)"
        fi
        machine_entry="$(jq -cn --arg key "${machine_key}" --arg title "${machine}: unreachable" --arg detail "${machine_detail}" \
            '{key:$key,state:"blocked",title:($title[:120]),detail:($detail[:600])}')"
        entries_json="$(jq -cn --argjson old "${previous}" --arg key "${machine_key}" --argjson machine "${machine_entry}" \
            '([$old.entries[]? | select(.key != $key)] + [$machine])')"
        warnings_json="$(jq -c '.warnings // []' <<< "${previous}")"
        feed="$(finish_feed "${entries_json}" "${previous}" true "${machine_key}" "${warnings_json}")" || return 1
    fi

    write_atomic "${target}" "${feed}"
}

if [[ "${1:-}" == --help ]]; then
    sed -n 's/^# //p' "${BASH_SOURCE[0]}" | head -n 12
    exit 0
fi
if [[ "${1:-}" == --prune ]]; then
    prune=1
    shift
elif [[ "${1:-}" == --* ]]; then
    usage
fi
if (($# == 0 || $# % 3 != 0)); then usage; fi

mkdir -p "${feed_dir}"
while (($#)); do
    machine="$1"
    agents_file="$2"
    tabs_file="$3"
    shift 3
    if ! write_machine "${machine}" "${agents_file}" "${tabs_file}"; then failed=1; fi
    scanned_machines+="${machine}"$'\n'
done

if ((prune)); then
    for file in "${feed_dir}"/herdr-*.json; do
        [[ -f "${file}" ]] || continue
        machine="${file##*/herdr-}"
        machine="${machine%.json}"
        if ! grep -qxF -- "${machine}" <<< "${scanned_machines}"; then
            rm -f "${file}"
        fi
    done
fi

exit "${failed}"
