#!/usr/bin/env bash

# @file home/private_dot_local/private_bin/exact_common/executable_herdr-meta-patrol-queue
# @brief Queue meta patrol messages in a file and wait for them without typing into a pane.
# @description
#   The meta patrol and local root orchestrators append messages here instead of
#   typing them into the meta agent's pane. The meta agent runs `wait` as a
#   background command; it exits when an unread message exists, which wakes the
#   agent through its harness. `read` shows at most ten unread records by default;
#   the agent handles that batch and acknowledges its highest sequence number.
#   `read --compact-status` omits older STATUS updates from the same sender within
#   that batch. The original records remain on disk until the agent acknowledges
#   the batch. Delivery is at least once: an unacknowledged record stays unread.
#
#   Files in the state directory: `queue.jsonl` holds one JSON record per line
#   (`seq`, `t` epoch seconds, `at`, `kind`, `from`, `text`); imported remote
#   records also include `machine` and `source_seq`. `queue.seq` is the last
#   sequence number, `queue.ack` the highest acknowledged one, `waiter.heartbeat`
#   the time of the last `wait` poll, and `queue.notified` the last sequence
#   number announced by `notify-if-stale`. Session-owned `wait` commands record
#   their PID in `waiters/<pane-id>.<pid>.pid` until they exit.
#
#   Subcommands:
#   - `add [--kind KIND] [--from NAME] TEXT` appends one record.
#   - `import --machine NAME RECORD_JSON` appends one remote record with its
#     original timestamp and source sequence. Repeating the same import is safe.
#   - `wait [--max-seconds N]` blocks until an unread record exists, prints the
#     unread count, and exits 0. It also exits 0 after N seconds (default 21600)
#     with a re-arm notice.
#   - `read [--limit N] [--compact-status]` prints up to N unread records (default
#     10, maximum 50), one JSON object per line. Compaction retains the latest
#     STATUS from each sender and every other record in the selected batch.
#     `read --strict` requires a regular queue file, valid acknowledgement state,
#     and valid records before returning unread-record and malformed-line counts.
#   - `ack SEQ` marks every record up to SEQ as handled.
#   - `trim` drops acknowledged records older than the keep period.
#   - `notify-if-stale` shows one Herdr notification for a batch of unread records
#     that are old enough while no `wait` has polled recently.
# @option HERDR_META_PATROL_STATE_DIR State directory (default `~/.local/state/herdr-meta-patrol`).
# @option HERDR_META_PATROL_QUEUE_POLL Seconds between `wait` polls (default 5).
# @option HERDR_META_PATROL_QUEUE_KEEP_DAYS Days to keep acknowledged records (default 7).
# @option HERDR_META_PATROL_TIMEOUT Seconds before the notification call is killed (default 40).
# @option HERDR_META_PATROL_STALE_SECONDS Age of unread records and of the waiter heartbeat that triggers a notification (default 600).
# @option --limit N Number of raw unread records to include in a read batch (1-50; default 10).
# @option --compact-status Show only the latest STATUS per sender within a read batch.
# @option --strict Return a JSON envelope; fail when queue state or records are invalid.
# @stderr queue unverifiable: <why> when strict queue state cannot be verified.
# @exitcode 0 On success.
# @exitcode 2 On a usage error.
# @example
#   herdr-meta-patrol-queue add --kind findings "$message"
#   herdr-meta-patrol-queue import --machine remote "$record_json"
#   herdr-meta-patrol-queue wait
#   herdr-meta-patrol-queue read --compact-status
#   herdr-meta-patrol-queue ack 12

set -Eeuo pipefail

state_dir="${HERDR_META_PATROL_STATE_DIR:-${HOME}/.local/state/herdr-meta-patrol}"
poll_seconds="${HERDR_META_PATROL_QUEUE_POLL:-5}"
keep_days="${HERDR_META_PATROL_QUEUE_KEEP_DAYS:-7}"
stale_seconds="${HERDR_META_PATROL_STALE_SECONDS:-600}"
queue="${state_dir}/queue.jsonl"
seq_file="${state_dir}/queue.seq"
ack_file="${state_dir}/queue.ack"
heartbeat="${state_dir}/waiter.heartbeat"
notified_file="${state_dir}/queue.notified"
lock_file="${state_dir}/queue.lock"
waiters_dir="${state_dir}/waiters"
waiter_marker=''

# @description Print a usage error and exit 2.
function usage() {
    printf '%s\n' 'usage: herdr-meta-patrol-queue add [--kind KIND] [--from NAME] TEXT | import --machine NAME RECORD_JSON | wait [--max-seconds N] | read [--limit N] [--compact-status] | ack SEQ | trim | notify-if-stale' >&2
    exit 2
}

# @description Print the number stored in a file, or 0.
# @arg $1 string File path.
function number_in() {
    local value=""
    value="$(cat "$1" 2> /dev/null)" || value=""
    [[ "${value}" =~ ^[0-9]+$ ]] || value=0
    printf '%s\n' "${value}"
}

# @description Return the highest valid local sequence number in the queue.
function queue_max_seq_locked() {
    [[ ! -e "${queue}" ]] && {
        printf '0\n'
        return 0
    }
    [[ -f "${queue}" && -r "${queue}" ]] || return 1
    jq -Rsc '
        split("\n") |
        [ .[] | (try fromjson catch null) | select(type == "object") | .seq? |
          select(type == "number" and . > 0 and floor == .) ] |
        max // 0
    ' "${queue}"
}

# @description Repair the local sequence counter to include every queued record.
function repair_import_seq_locked() {
    local queue_seq current_seq
    queue_seq="$(queue_max_seq_locked)" || return 1
    current_seq="$(number_in "${seq_file}")"
    if ((current_seq < queue_seq)); then
        printf '%s\n' "${queue_seq}" > "${seq_file}.tmp" || return 1
        mv "${seq_file}.tmp" "${seq_file}" || return 1
        current_seq="${queue_seq}"
    fi
    printf '%s\n' "${current_seq}"
}

# @description Report why strict queue state cannot be verified.
# @arg $1 string Validation failure reason.
function queue_unverifiable() {
    printf 'queue unverifiable: %s\n' "$1" >&2
}

# @description Run a command while holding the queue lock (perl ships with macOS).
function with_lock() {
    perl -MFcntl=:flock -e 'open(my $fh, ">>", shift) or die "lock: $!\n"; flock($fh, LOCK_EX) or die "lock: $!\n"; my $r = system(@ARGV); exit($r & 127 ? 128 + ($r & 127) : $r >> 8)' "${lock_file}" "$@"
}

# @description Append one record; runs under the queue lock.
# @arg $1 string Kind.
# @arg $2 string Sender name.
# @arg $3 string Text.
function append_locked() {
    local seq now
    seq=$(($(number_in "${seq_file}") + 1))
    now="$(date +%s)"
    # A line cut short by an earlier failed write must not swallow this record.
    if [[ -s "${queue}" && -n "$(tail -c 1 "${queue}")" ]]; then
        printf '\n' >> "${queue}" || return 1
    fi
    jq -cn --argjson seq "${seq}" --argjson t "${now}" --arg at "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        --arg kind "$1" --arg from "$2" --arg text "$3" \
        '{seq: $seq, t: $t, at: $at, kind: $kind, from: $from, text: $text}' >> "${queue}" || return 1
    printf '%s\n' "${seq}" > "${seq_file}.tmp" || return 1
    mv "${seq_file}.tmp" "${seq_file}"
}

# @description Append one remote record with its original time; runs under the queue lock.
# @arg $1 string Saved machine label that owns the source record.
# @arg $2 string JSON object from the remote queue.
function append_import_locked() {
    local machine="$1" record="$2" source_seq seq current_seq
    source_seq="$(jq -er '.seq | select(type == "number" and floor == . and . > 0)' <<< "${record}")" || return 2
    current_seq="$(repair_import_seq_locked)" || return 1
    if [[ -s "${queue}" ]] && jq -e -R --arg machine "${machine}" --argjson source_seq "${source_seq}" \
        'fromjson? | select(.machine == $machine and .source_seq == $source_seq)' "${queue}" > /dev/null; then
        return 0
    fi
    seq=$((current_seq + 1))
    if [[ -s "${queue}" && -n "$(tail -c 1 "${queue}")" ]]; then
        printf '\n' >> "${queue}" || return 1
    fi
    jq -cn --argjson seq "${seq}" --arg machine "${machine}" --argjson source "${record}" \
        '{seq: $seq, t: $source.t, at: $source.at, kind: $source.kind,
          from: $source.from, text: $source.text, machine: $machine, source_seq: $source.seq}' \
        >> "${queue}" || return 1
    printf '%s\n' "${seq}" > "${seq_file}.tmp" || return 1
    mv "${seq_file}.tmp" "${seq_file}"
}

# @description Drop acknowledged records older than the keep period; runs under the queue lock.
function trim_locked() {
    local ack cutoff
    [[ -s "${queue}" ]] || return 0
    ack="$(number_in "${ack_file}")"
    cutoff=$(($(date +%s) - keep_days * 86400))
    jq -cR --argjson ack "${ack}" --argjson cutoff "${cutoff}" 'fromjson? // empty | select(.seq > $ack or .t >= $cutoff)' "${queue}" > "${queue}.tmp" &&
        mv "${queue}.tmp" "${queue}"
}

# @description Print the unread records.
function read_unread() {
    [[ -s "${queue}" ]] || return 0
    jq -cR --argjson ack "$(number_in "${ack_file}")" 'fromjson? // empty | select(.seq > $ack)' "${queue}"
}

# @description Print a bounded unread batch, optionally omitting superseded STATUS updates.
# @arg $1 number Maximum number of raw unread records.
# @arg $2 boolean Whether to compact STATUS updates from the same sender.
# @arg $3 boolean Whether to require strict queue validation and return counts.
function read_batch() {
    local limit="$1" compact="$2" strict="${3:-false}" ack_value queue_result malformed_count
    if [[ "${strict}" == true ]]; then
        if [[ -L "${queue}" ]]; then
            queue_unverifiable 'queue.jsonl is a symbolic link'
            return 1
        elif [[ ! -e "${queue}" ]]; then
            queue_unverifiable 'queue.jsonl is missing'
            return 1
        elif [[ ! -f "${queue}" ]]; then
            queue_unverifiable 'queue.jsonl is not a regular file'
            return 1
        elif [[ ! -r "${queue}" ]]; then
            queue_unverifiable 'queue.jsonl is not readable'
            return 1
        fi

        ack_value=0
        if [[ -L "${ack_file}" ]]; then
            queue_unverifiable 'queue.ack is a symbolic link'
            return 1
        elif [[ -e "${ack_file}" ]]; then
            if [[ ! -f "${ack_file}" ]]; then
                queue_unverifiable 'queue.ack is not a regular file'
                return 1
            elif [[ ! -r "${ack_file}" ]]; then
                queue_unverifiable 'queue.ack is not readable'
                return 1
            elif ! ack_value="$(cat "${ack_file}" 2> /dev/null)"; then
                queue_unverifiable 'queue.ack could not be read'
                return 1
            elif [[ ! "${ack_value}" =~ ^[0-9]+$ ]]; then
                queue_unverifiable 'queue.ack is not a non-negative integer'
                return 1
            fi
            local ack_line_count
            if ! ack_line_count="$(awk 'END { print NR }' "${ack_file}" 2> /dev/null)" || [[ "${ack_line_count}" != 1 ]]; then
                queue_unverifiable 'queue.ack must contain exactly one integer line'
                return 1
            fi
            while [[ ${#ack_value} -gt 1 && "${ack_value:0:1}" == 0 ]]; do
                ack_value="${ack_value:1}"
            done
        fi

        if ! queue_result="$(jq -Rsc --argjson ack "${ack_value}" '
            def valid_record:
                if type == "object" and
                    (keys == ["at", "from", "kind", "seq", "t", "text"] or
                     keys == ["at", "from", "kind", "machine", "seq", "source_seq", "t", "text"]) and
                    (.seq | type) == "number" and (.t | type) == "number" and
                    (.at | type) == "string" and (.kind | type) == "string" and
                    (.from | type) == "string" and (.text | type) == "string"
                then .seq > 0 and (.seq | floor) == .seq and .t >= 0 and (.t | floor) == .t and
                    (.at | length) > 0 and (.kind | length) > 0 and
                    (.from | length) > 0 and (.text | length) > 0 and
                    (if has("machine") then
                        (.machine | type) == "string" and (.machine | length) > 0 and
                        (.source_seq | type) == "number" and (.source_seq | floor) == .source_seq and .source_seq > 0
                     else true end)
                else false end;
            split("\n") as $lines |
            (if ($lines[-1] // null) == "" then $lines[:-1] else $lines end) |
            reduce .[] as $line ({unread_record_count: 0, malformed_line_count: 0};
                (try ($line | fromjson) catch null) as $record |
                if ($record | valid_record) then
                    if $record.seq > $ack then .unread_record_count += 1 else . end
                else .malformed_line_count += 1 end
            )
        ' "${queue}")"; then
            queue_unverifiable 'queue.jsonl could not be read or parsed'
            return 1
        fi
        if ! malformed_count="$(jq -er '.malformed_line_count | if type == "number" and floor == . and . >= 0 then . else error end' <<< "${queue_result}" 2> /dev/null)"; then
            queue_unverifiable 'queue.jsonl validation result could not be read'
            return 1
        elif ((malformed_count > 0)); then
            queue_unverifiable "queue.jsonl contains ${malformed_count} malformed or invalid record(s)"
            return 1
        fi
        printf '%s\n' "${queue_result}"
        return
    fi
    read_unread | jq -sc --argjson limit "${limit}" --argjson compact "${compact}" '
        def is_status:
            . as $record |
            ($record.kind == "message") and
            ($record.from | type == "string") and
            ($record.text | type == "string") and
            ($record.text | startswith("STATUS " + $record.from + ":"));
        .[:$limit] as $batch |
        $batch | to_entries[] |
        .key as $index | .value as $record |
        if $compact and ($record | is_status) and
            any($batch[($index + 1):][]; .from == $record.from and is_status)
        then empty else $record end
    '
}

# @description Record a session-owned waiter so its Herdr pane can verify it is running.
function register_waiter() {
    local pane_id="${HERDR_PANE_ID:-}" temporary
    [[ "${HERDR_ENV:-}" == '1' ]] || return 0
    [[ "${pane_id}" =~ ^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$ ]] || return 0
    mkdir -p "${waiters_dir}" || return 1
    chmod 700 "${waiters_dir}" 2> /dev/null || return 1
    waiter_marker="${waiters_dir}/${pane_id}.$$.pid"
    temporary="${waiter_marker}.tmp"
    (umask 077 && printf '%s\n' "$$" > "${temporary}") || return 1
    if ! mv -f "${temporary}" "${waiter_marker}"; then
        rm -f "${temporary}"
        return 1
    fi
}

# @description Remove only this process's waiter record when it exits.
function cleanup_waiter() {
    local marker_pid=''
    [[ -n "${waiter_marker}" && -f "${waiter_marker}" ]] || return 0
    marker_pid="$(cat "${waiter_marker}" 2> /dev/null)" || marker_pid=''
    if [[ "${marker_pid}" == "$$" ]]; then
        rm -f "${waiter_marker}"
    fi
    return 0
}

(($# > 0)) || usage
command="$1"
shift
strict_read=false
if [[ "${command}" == read ]]; then
    for argument in "$@"; do
        if [[ "${argument}" == --strict ]]; then
            strict_read=true
        fi
    done
fi
if [[ "${strict_read}" != true ]]; then
    mkdir -p "${state_dir}"
fi

case "${command}" in
add)
    kind=message
    from=patrol
    while (($# > 1)); do
        case "$1" in
        --kind)
            kind="$2"
            shift 2
            ;;
        --from)
            from="$2"
            shift 2
            ;;
        *) usage ;;
        esac
    done
    (($# == 1)) && [[ -n "$1" ]] || usage
    export -f append_locked number_in
    export queue seq_file
    with_lock bash -c 'set -Eeuo pipefail; append_locked "$@"' _ "${kind}" "${from}" "$1"
    ;;
import)
    (($# == 3)) && [[ "$1" == --machine && -n "$2" ]] || usage
    machine="$2"
    record="$3"
    if ! jq -e '
        type == "object" and
        has("seq") and has("t") and has("at") and has("kind") and has("from") and has("text") and
        (.seq | type) == "number" and (.seq | floor) == .seq and .seq > 0 and
        (.t | type) == "number" and (.t | floor) == .t and .t >= 0 and
        (.at | type) == "string" and (.at | length) > 0 and
        (.kind | type) == "string" and (.kind | length) > 0 and
        (.from | type) == "string" and (.from | length) > 0 and
        (.text | type) == "string" and (.text | length) > 0
    ' <<< "${record}" > /dev/null; then
        printf '%s\n' 'invalid remote queue record' >&2
        exit 2
    fi
    export -f append_import_locked number_in queue_max_seq_locked repair_import_seq_locked
    export queue seq_file
    with_lock bash -c 'set -Eeuo pipefail; append_import_locked "$@"' _ "${machine}" "${record}"
    ;;
wait)
    max_seconds=21600
    if (($# == 2)) && [[ "$1" == --max-seconds && "$2" =~ ^[0-9]+$ ]]; then
        max_seconds="$2"
    elif (($# != 0)); then
        usage
    fi
    if ! register_waiter; then
        printf '%s\n' 'cannot register this session queue waiter' >&2
        exit 1
    fi
    trap cleanup_waiter EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    start="$(date +%s)"
    while :; do
        touch "${heartbeat}"
        unread=$(($(number_in "${seq_file}") - $(number_in "${ack_file}")))
        if ((unread > 0)); then
            printf 'unread %s: read, handle, then ack them\n' "${unread}"
            exit 0
        fi
        if (($(date +%s) - start >= max_seconds)); then
            printf '%s\n' 'no unread messages; restart wait'
            exit 0
        fi
        sleep "${poll_seconds}"
    done
    ;;
read)
    limit=10
    compact=false
    strict=false
    while (($# > 0)); do
        case "$1" in
        --limit)
            if (($# < 2)) || [[ ! "$2" =~ ^[1-9][0-9]?$ ]] || ((10#$2 > 50)); then
                usage
            fi
            limit="$2"
            shift 2
            ;;
        --compact-status)
            compact=true
            shift
            ;;
        --strict)
            strict=true
            shift
            ;;
        *) usage ;;
        esac
    done
    read_batch "${limit}" "${compact}" "${strict}"
    ;;
ack)
    (($# == 1)) && [[ "$1" =~ ^[0-9]+$ ]] || usage
    last="$(number_in "${seq_file}")"
    target="$1"
    ((target <= last)) || target="${last}"
    ((target > $(number_in "${ack_file}"))) || exit 0
    printf '%s\n' "${target}" > "${ack_file}.tmp"
    mv "${ack_file}.tmp" "${ack_file}"
    ;;
trim)
    (($# == 0)) || usage
    export -f trim_locked number_in
    export queue ack_file keep_days
    with_lock bash -c 'set -Eeuo pipefail; trim_locked'
    ;;
notify-if-stale)
    (($# == 0)) || usage
    now="$(date +%s)"
    last="$(number_in "${seq_file}")"
    (($(number_in "${ack_file}") < last)) || exit 0
    (($(number_in "${notified_file}") < last)) || exit 0
    oldest="$(read_unread | jq -s 'map(.t) | min // empty')"
    [[ -n "${oldest}" ]] && ((now - oldest >= stale_seconds)) || exit 0
    if [[ -e "${heartbeat}" ]]; then
        beat="$(perl -e 'print +(stat shift)[9]' "${heartbeat}")"
        ((now - beat >= stale_seconds)) || exit 0
    fi
    count="$(read_unread | wc -l | tr -d ' ')"
    perl -e 'alarm shift; exec @ARGV' "${HERDR_META_PATROL_TIMEOUT:-40}" herdr notification show 'meta patrol' --body "未読 ${count} 件。meta の待機（herdr-meta-patrol-queue wait）が動いていません。" > /dev/null 2>&1 || exit 0
    printf '%s\n' "${last}" > "${notified_file}"
    ;;
*) usage ;;
esac
