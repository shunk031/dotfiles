#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const TEXTLINT_PACKAGES = [
    "textlint@15.8.0",
    "textlint-rule-sentence-length@3.0.1",
    "textlint-filter-rule-comments@1.3.0",
];
const ANALYSIS_RULE = "markdown-neighbor-length-analysis";
const IGNORED_TYPES = ["Code", "CodeBlock", "Html", "Table"];
const TEXTLINT_API_RUNNER_SOURCE = String.raw`(async () => {
    const fs = require("node:fs/promises");
    const fsSync = require("node:fs");
    const path = require("node:path");
    const { createRequire } = require("node:module");
    const modulesDir = process.env.PATH.split(path.delimiter)
        .map((entry) => path.resolve(entry, ".."))
        .find((entry) => fsSync.existsSync(path.join(entry, "textlint", "package.json")));
    if (!modulesDir) throw new Error("could not locate textlint packages");
    const packageRequire = createRequire(path.join(modulesDir, "textlint", "package.json"));
    const { createLinter, loadTextlintrc } = packageRequire("textlint");
    const { TextlintKernelDescriptor } = packageRequire("@textlint/kernel");
    const { splitAST, Syntax: SentenceSyntax } = packageRequire("sentence-splitter");
    const { StringSource } = packageRequire("textlint-util-to-string");
    const [configPath, ...inputFiles] = process.argv.slice(1);
    const ignoredTypes = new Set(["Code", "CodeBlock", "Html", "Table"]);

    function withoutIgnoredTypes(node, keepInlineCode = false) {
        if (ignoredTypes.has(node.type) && !(keepInlineCode && node.type === "Code")) return null;
        if (!node.children) return node;
        return {
            ...node,
            children: node.children.map((child) => withoutIgnoredTypes(child, keepInlineCode)).filter(Boolean),
        };
    }

    function text(node, rootListItem = null) {
        if (
            ignoredTypes.has(node.type) ||
            (node.type === "ListItem" && rootListItem && node !== rootListItem)
        ) return "";
        if (node.type === "ListItem") {
            const item = rootListItem || node;
            return (node.children || [])
                .map((child) => text(child, item))
                .filter(Boolean)
                .join(" ");
        }
        if (["Paragraph", "Header", "Sentence"].includes(node.type)) {
            const filtered = withoutIgnoredTypes(node);
            return filtered
                ? new StringSource(filtered).toString().replace(/\s+/gu, " ").trim()
                : "";
        }
        return (node.children || []).map((child) => text(child, rootListItem)).filter(Boolean).join("");
    }

    function analysisRule(context) {
        return {
            [context.Syntax.DocumentExit](document) {
                const analysis = { headers: [], lines: [], units: [], bullets: [] };
                const lines = new Map();

                function visit(node, lists = [], item = null) {
                    if (ignoredTypes.has(node.type)) return;
                    if (node.type === "Header") {
                        analysis.headers.push({
                            text: new StringSource(withoutIgnoredTypes(node, true)).toString().replace(/\s+/gu, " ").trim(),
                            depth: node.depth,
                            line: node.loc.start.line,
                        });
                    }
                    if (node.type === "List") {
                        const nestedLists = [...lists, { ordered: node.ordered }];
                        for (const child of node.children || []) visit(child, nestedLists, item);
                        return;
                    }
                    if (node.type === "ListItem") {
                        const current = {
                            ordered: Boolean(lists[lists.length - 1]?.ordered),
                            depth: lists.length,
                        };
                        if (!current.ordered) {
                            const bullet = text(node, node);
                            analysis.bullets.push({
                                line: node.loc.start.line,
                                depth: lists.filter((list) => !list.ordered).length,
                                hasChildren: (node.children || []).some(
                                    (child) => child.type === "List" && !child.ordered,
                                ),
                            });
                            if (bullet) {
                                analysis.units.push({
                                    kind: "bullet",
                                    text: bullet,
                                    line: node.loc.start.line,
                                    length: [...bullet].length,
                                });
                            }
                        }
                        for (const child of node.children || []) visit(child, lists, current);
                        return;
                    }
                    if (node.type === "Paragraph") {
                        const paragraphText = text(node);
                        if (paragraphText) {
                            const kind = !item ? "prose" : item.ordered ? "numbered" : "bullet";
                            const depth = item ? item.depth : 0;
                            for (let line = node.loc.start.line; line <= node.loc.end.line; line += 1) {
                                const previous = lines.get(line);
                                if (!previous || depth >= previous.depth) lines.set(line, { kind, depth });
                            }
                            if (!item || item.ordered) {
                                const paragraph = withoutIgnoredTypes(node);
                                for (const sentence of splitAST(paragraph).children) {
                                    if (sentence.type !== SentenceSyntax.Sentence) continue;
                                    const sentenceText = text(sentence);
                                    if (!sentenceText) continue;
                                    analysis.units.push({
                                        kind: "sentence",
                                        text: sentenceText,
                                        line: sentence.loc.start.line,
                                        length: [...sentenceText].length,
                                    });
                                }
                            }
                        }
                    }
                    for (const child of node.children || []) visit(child, lists, item);
                }

                visit(document);
                analysis.lines = [...lines].map(([line, value]) => ({ line, ...value }));
                context.report(document, new context.RuleError(JSON.stringify(analysis)));
            },
        };
    }

    let descriptor = await loadTextlintrc({
        configFilePath: configPath,
        node_modulesDir: modulesDir,
    });
    descriptor = descriptor.concat(
        new TextlintKernelDescriptor({
            rules: [{ ruleId: "${ANALYSIS_RULE}", rule: analysisRule, options: true }],
            filterRules: [],
            plugins: [],
        }),
    );
    const linter = createLinter({ descriptor });
    const reports = await Promise.all(
        inputFiles.map(async (filePath) =>
            linter.lintText(await fs.readFile(filePath, "utf8"), filePath),
        ),
    );
    process.stdout.write(JSON.stringify(reports));
})().catch((error) => {
    console.error(error);
    process.exitCode = 1;
});`;

function usage() {
    return [
        "usage: markdown-neighbor-length [--report] <document.md> --heading <name>",
        "       markdown-neighbor-length [--report] <document.md> --edited-file <part.md>",
        "Form compares the predominant line kind; structure fails above neighbors' median + 2 bullets or above 4 when neighbors nest.",
        "Flat edited bullets fail when neighbors nest; --report shows shares and hierarchy measurements.",
    ].join("\n");
}

function parseArguments(args) {
    const options = { help: false, report: false, document: null, heading: null, editedFile: null };
    for (let index = 0; index < args.length; index += 1) {
        const argument = args[index];
        if (argument === "--help" || argument === "-h") options.help = true;
        else if (argument === "--report") options.report = true;
        else if (argument === "--heading" || argument === "--edited-file") {
            const key = argument === "--heading" ? "heading" : "editedFile";
            if (options[key] || !args[index + 1]) throw new Error(usage());
            options[key] = args[++index];
        } else if (argument.startsWith("-") || options.document) throw new Error(usage());
        else options.document = argument;
    }
    if (!options.help && (!options.document || Boolean(options.heading) === Boolean(options.editedFile))) {
        throw new Error(usage());
    }
    return options;
}

function analyze(contents) {
    const directory = fs.mkdtempSync(path.join(os.tmpdir(), "markdown-neighbor-length-"));
    try {
        const configPath = path.join(directory, ".textlintrc.json");
        fs.writeFileSync(configPath, JSON.stringify({ rules: {}, filters: { comments: true } }));
        const inputFiles = contents.map((content, index) => {
            const filePath = path.join(directory, `${index}.md`);
            fs.writeFileSync(filePath, content);
            return filePath;
        });
        const npmCache =
            process.env.NPM_CONFIG_CACHE ||
            path.join(process.env.TMPDIR || os.tmpdir(), "codex-npm-cache");
        const result = spawnSync(
            "npm",
            [
                "exec",
                "--yes",
                ...TEXTLINT_PACKAGES.map((name) => `--package=${name}`),
                "--",
                "node",
                "-e",
                TEXTLINT_API_RUNNER_SOURCE,
                configPath,
                ...inputFiles,
            ],
            {
                cwd: directory,
                encoding: "utf8",
                env: { ...process.env, NPM_CONFIG_CACHE: npmCache },
                maxBuffer: 16 * 1024 * 1024,
            },
        );
        if (result.error) throw result.error;
        if (result.status !== 0) {
            throw new Error(`textlint exited with status ${result.status}: ${(result.stderr || "").trim()}`);
        }
        const reports = JSON.parse(result.stdout);
        if (!Array.isArray(reports) || reports.length !== inputFiles.length) {
            throw new Error("textlint returned an unexpected report");
        }
        return reports.map((report) => {
            const messages = report.messages || [];
            if (messages.length !== 1 || messages[0].ruleId !== ANALYSIS_RULE) {
                throw new Error("textlint returned an unexpected analysis message");
            }
            return JSON.parse(messages[0].message);
        });
    } finally {
        fs.rmSync(directory, { recursive: true, force: true });
    }
}

function median(values) {
    if (values.length === 0) return null;
    const sorted = [...values].sort((left, right) => left - right);
    const middle = Math.floor(sorted.length / 2);
    return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
}

function summarize(analysis) {
    const byKind = { bullet: 0, prose: 0, numbered: 0 };
    const depths = [];
    for (const line of analysis.lines) {
        byKind[line.kind] += 1;
        depths.push(line.depth);
    }
    const kindCounts = Object.entries(byKind).sort((left, right) => right[1] - left[1]);
    const totalLines = analysis.lines.length;
    const dominant = totalLines === 0
        ? "none"
        : kindCounts[0][1] === kindCounts[1][1]
          ? "mixed"
          : kindCounts[0][0];
    const bulletSections = new Map();
    function headerForLine(line) {
        let current = null;
        for (const header of analysis.headers) {
            if (header.line > line) break;
            current = header;
        }
        return current;
    }
    function sectionForLine(line) {
        const header = headerForLine(line);
        const key = header ? header.line : 0;
        if (!bulletSections.has(key)) {
            bulletSections.set(key, {
                headerLine: header ? header.line : null,
                name: header ? header.text : "before first heading",
                bulletCount: 0,
                nestedBulletCount: 0,
                topLevelBullets: 0,
                maxDepth: 0,
            });
        }
        return bulletSections.get(key);
    }
    for (const bullet of analysis.bullets) {
        const section = sectionForLine(bullet.line);
        section.bulletCount += 1;
        if (bullet.hasChildren) {
            section.nestedBulletCount += 1;
            section.maxDepth = Math.max(section.maxDepth, bullet.depth + 1);
        }
        if (bullet.depth === 1) section.topLevelBullets += 1;
        section.maxDepth = Math.max(section.maxDepth, bullet.depth);
    }
    const bulletSectionList = [...bulletSections.values()];
    const sectionBulletCounts = bulletSectionList.map((section) => section.topLevelBullets);
    const lengths = analysis.units.map((unit) => unit.length);
    return {
        analysis,
        byKind,
        totalLines,
        dominant,
        depthMedian: median(depths),
        depthMax: depths.length ? depths.reduce((maximum, depth) => Math.max(maximum, depth), 0) : null,
        unitCount: lengths.length,
        unitMedian: median(lengths),
        unitMax: lengths.length ? lengths.reduce((maximum, length) => Math.max(maximum, length), 0) : null,
        sentenceCount: analysis.units.filter((unit) => unit.kind === "sentence").length,
        bulletCount: analysis.units.filter((unit) => unit.kind === "bullet").length,
        structuralBulletCount: analysis.bullets.length,
        nestedBulletCount: analysis.bullets.filter((bullet) => bullet.hasChildren).length,
        structureDepthMax: bulletSectionList.length
            ? bulletSectionList.reduce((maximum, section) => Math.max(maximum, section.maxDepth), 0)
            : null,
        topLevelBulletMedian: median(sectionBulletCounts),
        bulletSections: bulletSectionList,
    };
}

function formatNumber(value) {
    if (value === null) return "none";
    return Number.isInteger(value) ? String(value) : value.toFixed(1);
}

function formName(kind) {
    return {
        bullet: "mostly bullets",
        prose: "mostly prose paragraphs",
        numbered: "mostly numbered steps",
        mixed: "a mixed form",
        none: "no measurable form",
    }[kind];
}

function formatForm(summary) {
    const share = (count) =>
        `${count}/${summary.totalLines} (${summary.totalLines ? ((count / summary.totalLines) * 100).toFixed(1) : "0.0"}%)`;
    return (
        `${formName(summary.dominant)} ` +
        `(bullets ${share(summary.byKind.bullet)}, prose ${share(summary.byKind.prose)}, ` +
        `numbered steps ${share(summary.byKind.numbered)})`
    );
}

function formatSummary(label, summary) {
    const nestedShare = summary.structuralBulletCount
        ? `${((summary.nestedBulletCount / summary.structuralBulletCount) * 100).toFixed(1)}%`
        : "0.0%";
    const sectionCounts = summary.bulletSections.length
        ? summary.bulletSections
              .map((section) =>
                  section.headerLine
                      ? `"${section.name}" at line ${section.headerLine}: ${section.topLevelBullets}`
                      : `before first heading: ${section.topLevelBullets}`,
              )
              .join(", ")
        : "none";
    return [
        `${label}:`,
        `  Content lines: ${summary.totalLines}`,
        `  Form: ${formatForm(summary)}`,
        `  Nesting depth: median ${formatNumber(summary.depthMedian)}, max ${formatNumber(summary.depthMax)}`,
        `  Bullet hierarchy: ${summary.structuralBulletCount} bullets; ${summary.nestedBulletCount} with children ` +
            `(${nestedShare}); max depth ${formatNumber(summary.structureDepthMax)}`,
        `  Top-level bullets per section: ${sectionCounts}; median ${formatNumber(summary.topLevelBulletMedian)}`,
        `  Sentences/bullets: ${summary.unitCount} (${summary.sentenceCount} sentences, ${summary.bulletCount} bullets); ` +
            `median ${formatNumber(summary.unitMedian)} chars; max ${formatNumber(summary.unitMax)} chars`,
    ].join("\n");
}

function selectAnalysis(analysis, includeLine) {
    return {
        headers: analysis.headers.filter((header) => includeLine(header.line)),
        lines: analysis.lines.filter((line) => includeLine(line.line)),
        units: analysis.units.filter((unit) => includeLine(unit.line)),
        bullets: analysis.bullets.filter((bullet) => includeLine(bullet.line)),
    };
}

function compare(neighbors, edited, editedLabel) {
    const failures = [];
    if (neighbors.dominant !== edited.dominant) {
        failures.push(
            `Form differs: neighbors are ${formName(neighbors.dominant)}; ${editedLabel} is ${formName(edited.dominant)}.`,
        );
    }
    const neighborsNest = neighbors.structureDepthMax !== null && neighbors.structureDepthMax > 1;
    if (neighborsNest) {
        for (const section of edited.bulletSections) {
            if (section.bulletCount > 0 && section.maxDepth <= 1) {
                const label = section.headerLine
                    ? `section "${section.name}" at line ${section.headerLine}`
                    : editedLabel;
                failures.push(
                    `Bullet hierarchy differs: ${label} is flat (max depth ${formatNumber(section.maxDepth)}); ` +
                        `neighbors nest (max depth ${formatNumber(neighbors.depthMax)}).`,
                );
            }
        }
    }
    if (neighbors.topLevelBulletMedian !== null) {
        const siblingLimit = neighbors.topLevelBulletMedian + 2;
        const limit = neighborsNest ? Math.min(siblingLimit, 4) : siblingLimit;
        for (const section of edited.bulletSections) {
            if (section.topLevelBullets <= limit) continue;
            const label = section.headerLine
                ? `section "${section.name}" at line ${section.headerLine}`
                : editedLabel;
            failures.push(
                `Top-level bullet siblings in ${label}: ${section.topLevelBullets}; limit: ${formatNumber(limit)} ` +
                    `(neighbors' median: ${formatNumber(neighbors.topLevelBulletMedian)}; ` +
                    `${neighborsNest ? "neighbors nest" : "neighbors are flat"}).`,
            );
        }
    }
    for (const unit of edited.analysis.units) {
        if (unit.length > neighbors.unitMedian) {
            const type = unit.kind === "bullet" ? "Bullet" : "Sentence";
            failures.push(
                `${type} in ${editedLabel} at line ${unit.line}: ${unit.length} chars; ` +
                    `neighbor median limit: ${formatNumber(neighbors.unitMedian)} chars. ${unit.text}`,
            );
        }
    }
    return failures;
}

function normalizedHeading(value) {
    return value.replace(/^\s*#{1,6}\s*/u, "").replace(/\s+#+\s*$/u, "").replace(/\s+/gu, " ").trim();
}

function main() {
    try {
        const options = parseArguments(process.argv.slice(2));
        if (options.help) {
            process.stdout.write(`${usage()}\n`);
            return;
        }
        const documentPath = path.resolve(options.document);
        const document = fs.readFileSync(documentPath, "utf8");
        let neighborsAnalysis;
        let editedAnalysis;
        let editedLabel;

        if (options.heading) {
            const [analysis] = analyze([document]);
            const headingName = normalizedHeading(options.heading);
            const matches = analysis.headers.filter((header) => normalizedHeading(header.text) === headingName);
            if (matches.length === 0) throw new Error(`heading not found: ${options.heading}`);
            if (matches.length > 1) throw new Error(`heading is ambiguous: ${options.heading}`);
            const heading = matches[0];
            const nextHeading = analysis.headers.find(
                (candidate) => candidate.line > heading.line && candidate.depth <= heading.depth,
            );
            const endLine = nextHeading ? nextHeading.line - 1 : document.split(/\r?\n/u).length;
            editedAnalysis = selectAnalysis(analysis, (line) => line >= heading.line && line <= endLine);
            neighborsAnalysis = selectAnalysis(analysis, (line) => line < heading.line || line > endLine);
            editedLabel = `section "${headingName}" in ${path.basename(documentPath)}`;
        } else {
            const editedPath = path.resolve(options.editedFile);
            const editedText = fs.readFileSync(editedPath, "utf8");
            [neighborsAnalysis, editedAnalysis] = analyze([document, editedText]);
            editedLabel = `edited file ${path.basename(editedPath)}`;
        }

        const neighbors = summarize(neighborsAnalysis);
        const edited = summarize(editedAnalysis);
        if (neighbors.unitMedian === null) throw new Error("no measurable neighboring sentences or bullets");
        if (edited.unitMedian === null) throw new Error(`no measurable sentences or bullets in ${editedLabel}`);
        const failures = compare(neighbors, edited, editedLabel);

        if (options.report) {
            process.stdout.write(
                `${formatSummary("Neighbors", neighbors)}\n${formatSummary(`Edited (${editedLabel})`, edited)}\n`,
            );
        }
        if (failures.length > 0) {
            process.stdout.write(`Markdown neighbor-length check failed:\n${failures.map((item) => `- ${item}`).join("\n")}\n`);
            process.exitCode = 1;
        } else if (!options.report) {
            process.stdout.write("Markdown neighbor-length check passed.\n");
        }
    } catch (error) {
        process.stderr.write(`${error.message}\n`);
        process.exitCode = error.message.startsWith("usage:") ? 2 : 1;
    }
}

main();
