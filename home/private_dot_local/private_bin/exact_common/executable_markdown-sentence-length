#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const crypto = require("node:crypto");
const fsSync = require("node:fs");
const fs = require("node:fs/promises");
const os = require("node:os");
const path = require("node:path");

// The rule has one max: use 100 to discover candidates, then apply 200 to
// non-Japanese sentences. Compare sentence text before and after so formatter
// line wrapping does not make existing long sentences look newly edited.
const DISCOVERY_LIMIT = 100;
const JAPANESE_LIMIT = 100;
const OTHER_LIMIT = 200;
const GITHUB_BODY_BLOCK_LIMIT = 600;
const RULE = "sentence-length";
const BODY_RULE = "github-body-paragraph-length";
const BODY_RULE_SOURCE = String.raw`module.exports = (context) => {
    const ignored = new Set(["Code", "CodeBlock", "Html", "Table"]);
    const urlPattern = /(?:[a-z][a-z\d+.-]*:\/\/|mailto:|www\.)[^\s<>()]+/giu;

    function prose(node, rootListItem) {
        if (ignored.has(node.type) || (node.type === "ListItem" && node !== rootListItem)) {
            return "";
        }
        if (node.type === "Str") return node.value.replace(urlPattern, " ");
        return (node.children || [])
            .map((child) => prose(child, rootListItem))
            .join(node.type === "ListItem" ? " " : "");
    }

    function report(node, continuations = []) {
        const text = [
            prose(node, node.type === "ListItem" ? node : null),
            ...continuations.map((paragraph) => prose(paragraph, null)),
        ]
            .join(" ")
            .replace(/\s+/gu, " ")
            .trim();
        const length = [...text].length;
        if (length <= __LIMIT__) return;
        context.report(
            node,
            new context.RuleError(
                JSON.stringify({
                    length,
                    preview: [...text].slice(0, 80).join("") + (length > 80 ? "…" : ""),
                }),
            ),
        );
    }

    return {
        [context.Syntax.DocumentExit](document) {
            const continuations = new Map();
            const skip = new Set();
            function findLazy(parent) {
                const children = parent.children || [];
                for (let index = 0; index < children.length; index += 1) {
                    const list = children[index];
                    if (list.type === "List") {
                        const item = (list.children || [])
                            .filter((child) => child.type === "ListItem")
                            .pop();
                        let endLine = list.loc?.end?.line;
                        for (let next = index + 1; item && next < children.length; next += 1) {
                            const paragraph = children[next];
                            if (
                                paragraph.type !== "Paragraph" ||
                                paragraph.loc?.start?.line !== endLine + 1
                            ) break;
                            const items = continuations.get(item) || [];
                            items.push(paragraph);
                            continuations.set(item, items);
                            skip.add(paragraph);
                            endLine = paragraph.loc.end.line;
                        }
                    }
                    findLazy(list);
                }
            }
            function visit(node, insideListItem = false) {
                if (node.type === "ListItem") report(node, continuations.get(node) || []);
                else if (node.type === "Paragraph" && !insideListItem && !skip.has(node)) report(node);
                for (const child of node.children || []) {
                    visit(child, insideListItem || node.type === "ListItem");
                }
            }
            findLazy(document);
            visit(document);
        },
    };
};`;

const TEXTLINT_PACKAGES = [
    "textlint@15.8.0",
    "textlint-rule-sentence-length@3.0.1",
    "textlint-filter-rule-comments@1.3.0",
];
const STATE_ROOT = path.resolve(
    process.env.SENTENCE_LENGTH_STATE_DIR ||
        path.join(
            os.tmpdir(),
            "dotfiles-sentence-length-state",
            typeof process.getuid === "function" ? String(process.getuid()) : "user",
        ),
);

function digest(value) {
    return crypto.createHash("sha256").update(value).digest("hex");
}

function markdownPath(value, cwd) {
    if (typeof value !== "string" || path.extname(value).toLowerCase() !== ".md") {
        return null;
    }
    return path.resolve(cwd, value);
}

function eventPaths(event) {
    const cwd = path.resolve(event.cwd || process.cwd());
    const input = event.tool_input || {};
    const rawPaths = [];

    if (typeof input.file_path === "string") {
        rawPaths.push(input.file_path);
    }

    const patch =
        typeof input === "string"
            ? input
            : typeof input.command === "string"
              ? input.command
              : typeof input.patch === "string"
                ? input.patch
                : "";
    for (const match of patch.matchAll(/^\*\*\* (?:Add|Update) File: (.+)$/gm)) {
        rawPaths.push(match[1].trim());
    }

    return [...new Set(rawPaths.map((value) => markdownPath(value, cwd)).filter(Boolean))];
}

function sessionDirectory(event, client) {
    if (typeof event.session_id !== "string" || event.session_id.length === 0) {
        throw new Error("hook payload does not include a session_id");
    }
    return path.join(STATE_ROOT, client, digest(event.session_id));
}

function snapshotFile(sessionDir, filePath) {
    return path.join(sessionDir, `${digest(filePath)}.json`);
}

async function readFileOrMissing(filePath) {
    try {
        return await fs.readFile(filePath, "utf8");
    } catch (error) {
        if (error.code === "ENOENT") {
            return null;
        }
        throw error;
    }
}

async function captureBefore(event, client) {
    const paths = eventPaths(event);
    if (paths.length === 0) {
        return;
    }

    const directory = sessionDirectory(event, client);
    const clientDirectory = path.dirname(directory);
    await fs.mkdir(STATE_ROOT, { recursive: true, mode: 0o700 });
    await fs.chmod(STATE_ROOT, 0o700);
    await fs.mkdir(clientDirectory, { recursive: true, mode: 0o700 });
    await fs.chmod(clientDirectory, 0o700);
    await fs.mkdir(directory, { recursive: true, mode: 0o700 });
    await fs.chmod(directory, 0o700);

    for (const filePath of paths) {
        const statePath = snapshotFile(directory, filePath);
        const baseline = await readFileOrMissing(filePath);
        const state = JSON.stringify({ filePath, baseline });
        try {
            await fs.writeFile(statePath, state, { flag: "wx", mode: 0o600 });
        } catch (error) {
            if (error.code !== "EEXIST") {
                throw error;
            }
        }
    }
}

async function recordsForPaths(event, client, requestedPaths = null) {
    const directory = sessionDirectory(event, client);
    let names;
    try {
        names = await fs.readdir(directory);
    } catch (error) {
        if (error.code === "ENOENT") {
            return [];
        }
        throw error;
    }

    const requested = requestedPaths ? new Set(requestedPaths) : null;
    const records = [];
    for (const name of names.filter((entry) => entry.endsWith(".json")).sort()) {
        const state = JSON.parse(await fs.readFile(path.join(directory, name), "utf8"));
        if (requested && !requested.has(state.filePath)) {
            continue;
        }
        records.push({
            filePath: state.filePath,
            baseline: state.baseline || "",
            current: (await readFileOrMissing(state.filePath)) || "",
        });
    }
    return records;
}

async function lintTexts(records, includeGithubBody = false) {
    if (records.length === 0) {
        return records.map(() => ({ baseline: [], current: [] }));
    }

    const directory = await fs.mkdtemp(path.join(os.tmpdir(), "markdown-sentence-length-"));
    try {
        const configPath = path.join(directory, ".textlintrc.json");
        const rules = {
            [RULE]: { max: DISCOVERY_LIMIT, countBy: "codepoints" },
        };
        if (includeGithubBody) {
            rules[BODY_RULE] = true;
            await fs.writeFile(
                path.join(directory, `${BODY_RULE}.js`),
                BODY_RULE_SOURCE.replace("__LIMIT__", GITHUB_BODY_BLOCK_LIMIT),
            );
        }
        await fs.writeFile(
            configPath,
            JSON.stringify({ rules, filters: { comments: true } }),
        );

        const inputFiles = [];
        const sources = new Map();
        const writes = [];
        records.forEach((record, index) => {
            for (const kind of ["baseline", "current"]) {
                const filePath = path.join(directory, `${index}-${kind}.md`);
                inputFiles.push(filePath);
                sources.set(filePath, { index, kind, content: record[kind] });
                writes.push(fs.writeFile(filePath, record[kind]));
            }
        });
        await Promise.all(writes);

        const npmCache =
            process.env.NPM_CONFIG_CACHE ||
            path.join(process.env.TMPDIR || os.tmpdir(), "codex-npm-cache");
        const args = [
            "exec",
            "--yes",
            ...TEXTLINT_PACKAGES.map((name) => `--package=${name}`),
            "--",
            "textlint",
            "--config",
            configPath,
            ...(includeGithubBody ? ["--rulesdir", directory] : []),
            "--format",
            "json",
            "--no-color",
            ...inputFiles,
        ];
        const result = spawnSync(
            "npm",
            args,
            {
                cwd: directory,
                encoding: "utf8",
                env: { ...process.env, NPM_CONFIG_CACHE: npmCache },
                maxBuffer: 16 * 1024 * 1024,
            },
        );
        if (result.error) {
            throw result.error;
        }
        if (result.status !== 0 && result.status !== 1) {
            throw new Error(
                `textlint exited with status ${result.status}: ${(result.stderr || "").trim()}`,
            );
        }

        let reports;
        try {
            reports = JSON.parse(result.stdout);
        } catch (error) {
            throw new Error(`textlint did not return JSON: ${error.message}`);
        }
        if (!Array.isArray(reports)) {
            throw new Error("textlint returned an unexpected JSON report");
        }

        const diagnostics = records.map(() => ({ baseline: [], current: [], blocks: [] }));
        for (const report of reports) {
            const source = sources.get(path.resolve(report.filePath));
            if (!source) {
                throw new Error(`textlint reported an unknown file: ${report.filePath}`);
            }
            for (const message of report.messages || []) {
                if (message.ruleId === BODY_RULE) {
                    const diagnostic = JSON.parse(message.message);
                    if (
                        !Number.isInteger(diagnostic.length) ||
                        diagnostic.length <= GITHUB_BODY_BLOCK_LIMIT ||
                        typeof diagnostic.preview !== "string"
                    ) {
                        throw new Error("textlint body-length output was invalid");
                    }
                    diagnostics[source.index].blocks.push({
                        kind: "paragraph",
                        preview: diagnostic.preview,
                        length: diagnostic.length,
                        limit: GITHUB_BODY_BLOCK_LIMIT,
                    });
                    continue;
                }
                if (message.ruleId !== RULE) {
                    throw new Error(message.message || "textlint reported an unexpected error");
                }
                const range = message.range;
                if (
                    !Array.isArray(range) ||
                    range.length !== 2 ||
                    !range.every(Number.isInteger) ||
                    range[0] < 0 ||
                    range[0] >= range[1] ||
                    range[1] > source.content.length
                ) {
                    throw new Error("textlint sentence-length output did not include a valid range");
                }
                const sentence = source.content.slice(range[0], range[1]).trim();
                diagnostics[source.index][source.kind].push({
                    line: message.line || 1,
                    length: [...sentence].length,
                    sentence,
                });
            }
        }
        return diagnostics;
    } finally {
        await fs.rm(directory, { recursive: true, force: true });
    }
}

function normalizedSentence(sentence) {
    return sentence.replace(/\s+/gu, " ").trim();
}

function isJapanese(sentence) {
    return /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u.test(sentence);
}

function changedViolations(records, diagnostics) {
    const violations = [];
    records.forEach((record, index) => {
        const baselineCounts = new Map();
        for (const sentence of diagnostics[index].baseline) {
            const key = normalizedSentence(sentence.sentence);
            baselineCounts.set(key, (baselineCounts.get(key) || 0) + 1);
        }

        for (const sentence of diagnostics[index].current) {
            const key = normalizedSentence(sentence.sentence);
            const previousCount = baselineCounts.get(key) || 0;
            if (previousCount > 0) {
                baselineCounts.set(key, previousCount - 1);
                continue;
            }

            const japanese = isJapanese(sentence.sentence);
            const limit = japanese ? JAPANESE_LIMIT : OTHER_LIMIT;
            if (sentence.length > limit) {
                violations.push({
                    filePath: record.filePath,
                    line: sentence.line,
                    sentence: normalizedSentence(sentence.sentence),
                    length: sentence.length,
                    limit,
                });
            }
        }
    });
    return violations;
}

function formatReason(violations) {
    const shown = violations.slice(0, 5);
    const items = shown.map(
        (item) =>
            `- File: ${item.filePath}\n` +
            `  Line: ${item.line}\n` +
            `  Sentence: ${item.sentence}\n` +
            `  Length: ${item.length} codepoints; limit: ${item.limit}\n` +
            "  Fix: split the sentence or rewrite it more briefly.",
    );
    const remaining =
        violations.length > shown.length
            ? `\n${violations.length - shown.length} more changed sentence(s) remain; fix these first and the hook will report the rest.`
            : "";
    return (
        `The edited Markdown contains ${violations.length} sentence(s) over the limit.\n` +
        items.join("\n") +
        remaining +
        "\nIf a definition or quotation must stay long, wrap only that text with blank lines around `<!-- textlint-disable sentence-length -->` and `<!-- textlint-enable sentence-length -->`."
    );
}

function formatGithubBodyReason(violations) {
    const sentences = violations.filter((item) => item.kind !== "paragraph");
    const paragraphs = violations.filter((item) => item.kind === "paragraph");
    const reason = [];
    if (sentences.length > 0) {
        reason.push(formatReason(sentences));
    }
    if (paragraphs.length > 0) {
        reason.push(
            "The edited GitHub body contains " +
                paragraphs.length +
                " paragraph(s) or list item(s) over the 600-codepoint limit.",
        );
        reason.push(
            paragraphs
                .slice(0, 5)
                .map(
                    (item) =>
                        "- File: GitHub body\n" +
                        "  Paragraph/list item: " +
                        item.preview +
                        "\n" +
                        "  Length: " +
                        item.length +
                        " codepoints; limit: " +
                        item.limit +
                        "\n" +
                        "  Fix: split the paragraph or list item.",
                )
                .join("\n"),
        );
        if (paragraphs.length > 5) {
            reason.push(
                (paragraphs.length - 5) +
                    " more paragraph(s) or list item(s) remain; split these first and the hook will report the rest.",
            );
        }
    }
    return reason.join("\n");
}

function block(reason) {
    process.stdout.write(`${JSON.stringify({ decision: "block", reason })}\n`);
}

async function formatClaudeMarkdown(filePaths, cwd) {
    if (filePaths.length === 0) {
        return;
    }
    const result = spawnSync("npx", ["prettier@2", "--write", ...filePaths], {
        cwd,
        encoding: "utf8",
        maxBuffer: 4 * 1024 * 1024,
    });
    if (result.error) {
        throw result.error;
    }
    if (result.status !== 0) {
        throw new Error(`Prettier failed: ${(result.stderr || result.stdout || "").trim()}`);
    }
}

async function checkRecords(event, client, requestedPaths = null) {
    const records = await recordsForPaths(event, client, requestedPaths);
    if (records.length === 0) {
        return [];
    }
    return changedViolations(records, await lintTexts(records));
}

// shortcut: shell expansions, compound commands, stdin body files, and unclassified gh flags fail open; extend when real gh invocations need it.
function parseSimpleShellCommand(command) {
    const args = [];
    let argument = "";
    let active = false;
    let quote = null;

    for (let index = 0; index < command.length; index += 1) {
        const character = command[index];
        if (quote === "single") {
            if (character === "'") {
                quote = null;
            } else {
                argument += character;
            }
            continue;
        }
        if (quote === "double") {
            if (character === '"') {
                quote = null;
            } else if (character === "\\") {
                const next = command[index + 1];
                if (next === undefined || next === "\n") {
                    return null;
                }
                if (["$", "`", '"', "\\"].includes(next)) {
                    argument += next;
                } else {
                    argument += `\\${next}`;
                }
                index += 1;
                active = true;
            } else if (character === "$" || character === "`") {
                return null;
            } else {
                argument += character;
                active = true;
            }
            continue;
        }

        if (character === " " || character === "\t") {
            if (active) {
                args.push(argument);
                argument = "";
                active = false;
            }
        } else if (character === "\n" || character === "\r") {
            return null;
        } else if (character === "'") {
            quote = "single";
            active = true;
        } else if (character === '"') {
            quote = "double";
            active = true;
        } else if (character === "\\") {
            const next = command[index + 1];
            if (next === undefined || next === "\n") {
                return null;
            }
            argument += next;
            index += 1;
            active = true;
        } else if (character === "~" && !active) {
            const next = command[index + 1];
            if (next !== undefined && next !== "/" && !/\s/u.test(next)) {
                return null;
            }
            argument += process.env.HOME || os.homedir();
            active = true;
        } else if (/[;&|<>()\[\]{}*?!$`]/u.test(character) || (character === "#" && !active)) {
            return null;
        } else {
            argument += character;
            active = true;
        }
    }

    if (quote !== null) {
        return null;
    }
    if (active) {
        args.push(argument);
    }
    return args;
}

const githubCommonFlags = new Map([
    ["--body", "body"],
    ["-b", "body"],
    ["--body-file", "file"],
    ["-F", "file"],
    ["--attach", "value"],
    ["--repo", "value"],
    ["-R", "value"],
    ["--help", "boolean"],
    ["-h", "boolean"],
]);

const githubCommandFlags = {
    "pr create": {
        value: "--title -t --base -B --head -H --reviewer -r --assignee -a --label -l --project -p --milestone -m --recover --template -T",
        boolean: "--draft -d --editor -e --web -w --fill-verbose --fill -f --fill-first --no-maintainer-edit --dry-run",
    },
    "pr edit": {
        value: "--title -t --base -B --add-reviewer --remove-reviewer --add-assignee --remove-assignee --add-label --remove-label --add-project --remove-project --milestone -m",
        boolean: "--remove-milestone",
    },
    "issue create": {
        value: "--title -t --assignee -a --label -l --project -p --milestone -m --recover --template -T --type --parent --blocked-by --blocking",
        boolean: "--editor -e --web -w",
    },
    "issue edit": {
        value: "--title -t --add-assignee --remove-assignee --add-label --remove-label --add-project --remove-project --milestone -m --type --parent --add-sub-issue --remove-sub-issue --add-blocked-by --remove-blocked-by --add-blocking --remove-blocking",
        boolean: "--remove-milestone --remove-type --remove-parent",
    },
    "issue comment": {
        value: "",
        boolean: "--editor -e --web -w --edit-last --delete-last --yes --create-if-none",
    },
};

function parsePflagBoolean(value) {
    if (["1", "t", "T", "TRUE", "true", "True"].includes(value)) {
        return true;
    }
    if (["0", "f", "F", "FALSE", "false", "False"].includes(value)) {
        return false;
    }
    return null;
}

function githubBodySource(command) {
    const args = parseSimpleShellCommand(command);
    if (!args || args[0] !== "gh") {
        return null;
    }

    const [kind, subcommand] = args.slice(1, 3);
    const commandFlags = githubCommandFlags[`${kind} ${subcommand}`];
    if (!commandFlags) {
        return null;
    }

    const flags = new Map(githubCommonFlags);
    for (const flag of commandFlags.value.split(/\s+/u).filter(Boolean)) {
        flags.set(flag, "value");
    }
    for (const flag of commandFlags.boolean.split(/\s+/u).filter(Boolean)) {
        flags.set(flag, "boolean");
    }

    let body;
    let bodyFile;
    let helpRequested = false;
    const setValue = (type, value) => {
        if (type === "body") {
            body = value;
        } else if (type === "file") {
            bodyFile = value;
        }
    };

    for (let index = 3; index < args.length; index += 1) {
        const option = args[index];
        if (option === "--") {
            break;
        }
        if (!option.startsWith("-") || option === "-") {
            continue;
        }

        if (option.startsWith("--")) {
            const equalIndex = option.indexOf("=");
            const flag = equalIndex < 0 ? option : option.slice(0, equalIndex);
            const type = flags.get(flag);
            if (!type) {
                return null;
            }
            if (type === "boolean") {
                const value = equalIndex < 0 ? true : parsePflagBoolean(option.slice(equalIndex + 1));
                if (value === null) {
                    return null;
                }
                if (flag === "--help") {
                    helpRequested = value;
                }
                continue;
            }

            const value = equalIndex < 0 ? args[++index] : option.slice(equalIndex + 1);
            if (value === undefined) {
                return null;
            }
            setValue(type, value);
            continue;
        }

        let shorthand = option.slice(1);
        while (shorthand) {
            const flag = `-${shorthand[0]}`;
            const type = flags.get(flag);
            if (!type) {
                return null;
            }
            const attached = shorthand.slice(1);
            if (type === "boolean") {
                if (attached.startsWith("=")) {
                    if (attached.length === 1) {
                        return null;
                    }
                    const value = parsePflagBoolean(attached.slice(1));
                    if (value === null) {
                        return null;
                    }
                    if (flag === "-h") {
                        helpRequested = value;
                    }
                    break;
                }
                if (flag === "-h") {
                    helpRequested = true;
                }
                shorthand = attached;
                continue;
            }

            const value =
                attached.startsWith("=") && attached.length > 1
                    ? attached.slice(1)
                    : attached || args[++index];
            if (value === undefined) {
                return null;
            }
            setValue(type, value);
            break;
        }
    }

    if (helpRequested) {
        return null;
    }
    const source = bodyFile ? { type: "file", value: bodyFile } : body === undefined ? null : { type: "body", value: body };
    return source ? { ...source, kind } : null;
}

async function checkGithubBody(event) {
    const input = event.tool_input || {};
    if (event.tool_name !== "Bash" || typeof input.command !== "string") {
        return [];
    }

    const source = githubBodySource(input.command);
    if (!source) {
        return [];
    }

    let content = source.value;
    let filePath = `GitHub ${source.kind} body`;
    if (source.type === "file") {
        if (!content || content === "-") {
            return [];
        }
        const cwd = path.resolve(event.cwd || process.cwd());
        filePath = path.resolve(cwd, content);
        content = await fs.readFile(filePath, "utf8");
    }

    const records = [{ filePath, baseline: "", current: content }];
    const diagnostics = await lintTexts(records, true);
    return [
        ...changedViolations(records, diagnostics),
        ...diagnostics[0].blocks,
    ];
}

async function removeSession(event, client) {
    await fs.rm(sessionDirectory(event, client), { recursive: true, force: true });
}

async function main() {
    const [action, client] = process.argv.slice(2);
    if (!["pre", "post", "stop"].includes(action) || !["claude", "codex"].includes(client)) {
        throw new Error("usage: markdown-sentence-length <pre|post|stop> <claude|codex>");
    }

    const event = JSON.parse(fsSync.readFileSync(0, "utf8") || "{}");
    if (action === "stop" && event.stop_hook_active === true) {
        await removeSession(event, client);
        return;
    }

    if (action === "pre") {
        if (event.tool_name === "Bash") {
            const violations = await checkGithubBody(event);
            if (violations.length > 0) {
                block(formatGithubBodyReason(violations));
            }
            return;
        }
        await captureBefore(event, client);
        return;
    }

    const filePaths = eventPaths(event);
    if (action === "post" && client === "claude") {
        await formatClaudeMarkdown(filePaths, path.resolve(event.cwd || process.cwd()));
    }

    const violations = await checkRecords(
        event,
        client,
        action === "post" ? filePaths : null,
    );
    if (violations.length > 0) {
        block(formatReason(violations));
        return;
    }

    if (action === "stop") {
        await removeSession(event, client);
    }
}

main().catch(() => {});
