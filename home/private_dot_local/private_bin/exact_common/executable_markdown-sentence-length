#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const crypto = require("node:crypto");
const fsSync = require("node:fs");
const fs = require("node:fs/promises");
const os = require("node:os");
const path = require("node:path");

// The rule has one max: use 100 to discover candidates, then apply 200 to
// non-Japanese sentences. Compare sentence text before and after so formatter
// line wrapping does not make existing long sentences look newly edited.
const DISCOVERY_LIMIT = 100;
const JAPANESE_LIMIT = 100;
const OTHER_LIMIT = 200;
const GITHUB_BODY_BLOCK_LIMIT = 600;
const GITHUB_BODY_PROSE_LIMIT = 1500;
const GITHUB_BODY_TOTAL_LIMIT_COMMANDS = new Set([
    "pr create",
    "pr edit",
    "issue create",
    "issue edit",
]);
const RULE = "sentence-length";
const BODY_RULE = "github-body-paragraph-length";
const BODY_RULE_SOURCE = String.raw`module.exports = (context) => {
    const ignored = new Set(["Code", "CodeBlock", "Html", "Table"]);
    const urlPattern = /(?:[a-z][a-z\d+.-]*:\/\/|mailto:|www\.)[^\s<>()]+/giu;

    function prose(node, rootListItem) {
        if (ignored.has(node.type) || (node.type === "ListItem" && node !== rootListItem)) {
            return "";
        }
        if (node.type === "Str") return node.value.replace(urlPattern, " ");
        return (node.children || [])
            .map((child) => prose(child, rootListItem))
            .join(node.type === "ListItem" ? " " : "");
    }

    function bodyProse(node) {
        if (ignored.has(node.type)) return "";
        if (node.type === "Str") return node.value.replace(urlPattern, " ");
        const children = node.children || [];
        const separator = ["Document", "BlockQuote", "List", "ListItem"].includes(node.type)
            ? "\n"
            : "";
        return children.map(bodyProse).join(separator);
    }

    function report(node, continuations = []) {
        const text = [
            prose(node, node.type === "ListItem" ? node : null),
            ...continuations.map((paragraph) => prose(paragraph, null)),
        ]
            .join(" ")
            .replace(/\s+/gu, " ")
            .trim();
        const length = [...text].length;
        if (length <= __LIMIT__) return;
        context.report(
            node,
            new context.RuleError(
                JSON.stringify({
                    length,
                    preview: [...text].slice(0, 80).join("") + (length > 80 ? "…" : ""),
                }),
            ),
        );
    }

    return {
        [context.Syntax.DocumentExit](document) {
            const bodyText = bodyProse(document).replace(/\s+/gu, " ").trim();
            const bodyLength = [...bodyText].length;
            if (bodyLength > __BODY_LIMIT__) {
                context.report(
                    document,
                    new context.RuleError(JSON.stringify({ bodyLength })),
                );
            }

            const continuations = new Map();
            const skip = new Set();
            function findLazy(parent) {
                const children = parent.children || [];
                for (let index = 0; index < children.length; index += 1) {
                    const list = children[index];
                    if (list.type === "List") {
                        const item = (list.children || [])
                            .filter((child) => child.type === "ListItem")
                            .pop();
                        if (item?.children?.at(-1)?.type === "Paragraph") {
                            let endLine = list.loc?.end?.line;
                            for (
                                let next = index + 1;
                                item && next < children.length;
                                next += 1
                            ) {
                                const paragraph = children[next];
                                if (
                                    paragraph.type !== "Paragraph" ||
                                    paragraph.loc?.start?.line !== endLine + 1
                                ) break;
                                const items = continuations.get(item) || [];
                                items.push(paragraph);
                                continuations.set(item, items);
                                skip.add(paragraph);
                                endLine = paragraph.loc.end.line;
                            }
                        }
                    }
                    findLazy(list);
                }
            }
            function visit(node, insideListItem = false) {
                if (node.type === "ListItem") report(node, continuations.get(node) || []);
                else if (node.type === "Paragraph" && !insideListItem && !skip.has(node)) report(node);
                for (const child of node.children || []) {
                    visit(child, insideListItem || node.type === "ListItem");
                }
            }
            findLazy(document);
            visit(document);
        },
    };
};`;

const TEXTLINT_API_RUNNER_SOURCE = String.raw`(async () => {
    const fs = require("node:fs/promises");
    const fsSync = require("node:fs");
    const path = require("node:path");
    const modulesDir = process.env.PATH.split(path.delimiter)
        .map((entry) => path.resolve(entry, ".."))
        .find((entry) => fsSync.existsSync(path.join(entry, "textlint", "package.json")));
    if (!modulesDir) throw new Error("could not locate textlint packages");
    const packageRequire = require("node:module").createRequire(
        path.join(modulesDir, "textlint", "package.json"),
    );
    const { createLinter, loadTextlintrc } = packageRequire("textlint");
    const { TextlintKernelDescriptor } = packageRequire("@textlint/kernel");
    const [configPath, bodyRulePath, ...inputFiles] = process.argv.slice(1);
    let descriptor = await loadTextlintrc({
        configFilePath: configPath,
        node_modulesDir: modulesDir,
    });
    if (bodyRulePath) {
        descriptor = descriptor.concat(
            new TextlintKernelDescriptor({
                rules: [
                    {
                        ruleId: "${BODY_RULE}",
                        rule: require(bodyRulePath),
                        options: true,
                    },
                ],
                filterRules: [],
                plugins: [],
            }),
        );
    }
    const linter = createLinter({ descriptor });
    const reports = await Promise.all(
        inputFiles.map(async (filePath) =>
            linter.lintText(await fs.readFile(filePath, "utf8"), filePath),
        ),
    );
    process.stdout.write(JSON.stringify(reports));
})().catch((error) => {
    console.error(error);
    process.exitCode = 1;
});`;

const TEXTLINT_PACKAGES = [
    "textlint@15.8.0",
    "textlint-rule-sentence-length@3.0.1",
    "textlint-filter-rule-comments@1.3.0",
];
const STATE_ROOT = path.resolve(
    process.env.SENTENCE_LENGTH_STATE_DIR ||
        path.join(
            os.tmpdir(),
            "dotfiles-sentence-length-state",
            typeof process.getuid === "function" ? String(process.getuid()) : "user",
        ),
);

function digest(value) {
    return crypto.createHash("sha256").update(value).digest("hex");
}

function markdownPath(value, cwd) {
    if (typeof value !== "string" || path.extname(value).toLowerCase() !== ".md") {
        return null;
    }
    return path.resolve(cwd, value);
}

function eventPaths(event) {
    const cwd = path.resolve(event.cwd || process.cwd());
    const input = event.tool_input || {};
    const rawPaths = [];

    if (typeof input.file_path === "string") {
        rawPaths.push(input.file_path);
    }

    const patch =
        typeof input === "string"
            ? input
            : typeof input.command === "string"
              ? input.command
              : typeof input.patch === "string"
                ? input.patch
                : "";
    for (const match of patch.matchAll(/^\*\*\* (?:Add|Update) File: (.+)$/gm)) {
        rawPaths.push(match[1].trim());
    }

    return [...new Set(rawPaths.map((value) => markdownPath(value, cwd)).filter(Boolean))];
}

function sessionDirectory(event, client) {
    if (typeof event.session_id !== "string" || event.session_id.length === 0) {
        throw new Error("hook payload does not include a session_id");
    }
    return path.join(STATE_ROOT, client, digest(event.session_id));
}

function snapshotFile(sessionDir, filePath) {
    return path.join(sessionDir, `${digest(filePath)}.json`);
}

async function readFileOrMissing(filePath) {
    try {
        return await fs.readFile(filePath, "utf8");
    } catch (error) {
        if (error.code === "ENOENT") {
            return null;
        }
        throw error;
    }
}

async function captureBefore(event, client) {
    const paths = eventPaths(event);
    if (paths.length === 0) {
        return;
    }

    const directory = sessionDirectory(event, client);
    const clientDirectory = path.dirname(directory);
    await fs.mkdir(STATE_ROOT, { recursive: true, mode: 0o700 });
    await fs.chmod(STATE_ROOT, 0o700);
    await fs.mkdir(clientDirectory, { recursive: true, mode: 0o700 });
    await fs.chmod(clientDirectory, 0o700);
    await fs.mkdir(directory, { recursive: true, mode: 0o700 });
    await fs.chmod(directory, 0o700);

    for (const filePath of paths) {
        const statePath = snapshotFile(directory, filePath);
        const baseline = await readFileOrMissing(filePath);
        const state = JSON.stringify({ filePath, baseline });
        try {
            await fs.writeFile(statePath, state, { flag: "wx", mode: 0o600 });
        } catch (error) {
            if (error.code !== "EEXIST") {
                throw error;
            }
        }
    }
}

async function recordsForPaths(event, client, requestedPaths = null) {
    const directory = sessionDirectory(event, client);
    let names;
    try {
        names = await fs.readdir(directory);
    } catch (error) {
        if (error.code === "ENOENT") {
            return [];
        }
        throw error;
    }

    const requested = requestedPaths ? new Set(requestedPaths) : null;
    const records = [];
    for (const name of names.filter((entry) => entry.endsWith(".json")).sort()) {
        const state = JSON.parse(await fs.readFile(path.join(directory, name), "utf8"));
        if (requested && !requested.has(state.filePath)) {
            continue;
        }
        records.push({
            filePath: state.filePath,
            baseline: state.baseline || "",
            current: (await readFileOrMissing(state.filePath)) || "",
        });
    }
    return records;
}

async function lintTexts(records, includeGithubBody = false) {
    if (records.length === 0) {
        return records.map(() => ({ baseline: [], current: [] }));
    }

    const directory = await fs.mkdtemp(path.join(os.tmpdir(), "markdown-sentence-length-"));
    try {
        const configPath = path.join(directory, ".textlintrc.json");
        const bodyRulePath = path.join(directory, `${BODY_RULE}.js`);
        const rules = {
            [RULE]: { max: DISCOVERY_LIMIT, countBy: "codepoints" },
        };
        if (includeGithubBody) {
            await fs.writeFile(
                bodyRulePath,
                BODY_RULE_SOURCE.replace("__LIMIT__", GITHUB_BODY_BLOCK_LIMIT).replace(
                    "__BODY_LIMIT__",
                    GITHUB_BODY_PROSE_LIMIT,
                ),
            );
        }
        await fs.writeFile(
            configPath,
            JSON.stringify({ rules, filters: { comments: true } }),
        );

        const inputFiles = [];
        const sources = new Map();
        const writes = [];
        records.forEach((record, index) => {
            for (const kind of ["baseline", "current"]) {
                const filePath = path.join(directory, `${index}-${kind}.md`);
                inputFiles.push(filePath);
                sources.set(filePath, {
                    index,
                    kind,
                    content: record[kind],
                    overrideBodyLength: kind === "current" && record.bodyLengthText !== undefined,
                });
                writes.push(fs.writeFile(filePath, record[kind]));
                if (kind === "current" && record.bodyLengthText !== undefined) {
                    const bodyLengthPath = path.join(directory, `${index}-body-length.md`);
                    inputFiles.push(bodyLengthPath);
                    sources.set(bodyLengthPath, {
                        index,
                        kind: "bodyLength",
                        content: record.bodyLengthText,
                    });
                    writes.push(fs.writeFile(bodyLengthPath, record.bodyLengthText));
                }
            }
        });
        await Promise.all(writes);

        const npmCache =
            process.env.NPM_CONFIG_CACHE ||
            path.join(process.env.TMPDIR || os.tmpdir(), "codex-npm-cache");
        const args = [
            "exec",
            "--yes",
            ...TEXTLINT_PACKAGES.map((name) => `--package=${name}`),
            "--",
            "node",
            "-e",
            TEXTLINT_API_RUNNER_SOURCE,
            configPath,
            includeGithubBody ? bodyRulePath : "",
            ...inputFiles,
        ];
        const result = spawnSync(
            "npm",
            args,
            {
                cwd: directory,
                encoding: "utf8",
                env: { ...process.env, NPM_CONFIG_CACHE: npmCache },
                maxBuffer: 16 * 1024 * 1024,
            },
        );
        if (result.error) {
            throw result.error;
        }
        if (result.status !== 0) {
            throw new Error(
                `textlint exited with status ${result.status}: ${(result.stderr || "").trim()}`,
            );
        }

        let reports;
        try {
            reports = JSON.parse(result.stdout);
        } catch (error) {
            throw new Error(`textlint did not return JSON: ${error.message}`);
        }
        if (!Array.isArray(reports)) {
            throw new Error("textlint returned an unexpected JSON report");
        }

        const diagnostics = records.map(() => ({
            baseline: [],
            current: [],
            blocks: [],
            bodyLength: 0,
        }));
        for (const report of reports) {
            const source = sources.get(path.resolve(report.filePath));
            if (!source) {
                throw new Error(`textlint reported an unknown file: ${report.filePath}`);
            }
            for (const message of report.messages || []) {
                if (message.ruleId === BODY_RULE) {
                    const diagnostic = JSON.parse(message.message);
                    if (Object.hasOwn(diagnostic, "bodyLength")) {
                        if (
                            !Number.isInteger(diagnostic.bodyLength) ||
                            diagnostic.bodyLength <= GITHUB_BODY_PROSE_LIMIT
                        ) {
                            throw new Error("textlint body-length output was invalid");
                        }
                        if (
                            source.kind === "bodyLength" ||
                            (source.kind === "current" && !source.overrideBodyLength)
                        ) {
                            diagnostics[source.index].bodyLength = diagnostic.bodyLength;
                        }
                        continue;
                    }
                    if (source.kind === "bodyLength") {
                        continue;
                    }
                    if (
                        !Number.isInteger(diagnostic.length) ||
                        diagnostic.length <= GITHUB_BODY_BLOCK_LIMIT ||
                        typeof diagnostic.preview !== "string"
                    ) {
                        throw new Error("textlint body-length output was invalid");
                    }
                    diagnostics[source.index].blocks.push({
                        kind: "paragraph",
                        preview: diagnostic.preview,
                        length: diagnostic.length,
                        limit: GITHUB_BODY_BLOCK_LIMIT,
                    });
                    continue;
                }
                if (source.kind === "bodyLength") {
                    continue;
                }
                if (message.ruleId !== RULE) {
                    throw new Error(message.message || "textlint reported an unexpected error");
                }
                const range = message.range;
                if (
                    !Array.isArray(range) ||
                    range.length !== 2 ||
                    !range.every(Number.isInteger) ||
                    range[0] < 0 ||
                    range[0] >= range[1] ||
                    range[1] > source.content.length
                ) {
                    throw new Error("textlint sentence-length output did not include a valid range");
                }
                const sentence = source.content.slice(range[0], range[1]).trim();
                diagnostics[source.index][source.kind].push({
                    line: message.line || 1,
                    length: [...sentence].length,
                    sentence,
                });
            }
        }
        return diagnostics;
    } finally {
        await fs.rm(directory, { recursive: true, force: true });
    }
}

function normalizedSentence(sentence) {
    return sentence.replace(/\s+/gu, " ").trim();
}

function isJapanese(sentence) {
    return /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u.test(sentence);
}

function changedViolations(records, diagnostics) {
    const violations = [];
    records.forEach((record, index) => {
        const baselineCounts = new Map();
        for (const sentence of diagnostics[index].baseline) {
            const key = normalizedSentence(sentence.sentence);
            baselineCounts.set(key, (baselineCounts.get(key) || 0) + 1);
        }

        for (const sentence of diagnostics[index].current) {
            const key = normalizedSentence(sentence.sentence);
            const previousCount = baselineCounts.get(key) || 0;
            if (previousCount > 0) {
                baselineCounts.set(key, previousCount - 1);
                continue;
            }

            const japanese = isJapanese(sentence.sentence);
            const limit = japanese ? JAPANESE_LIMIT : OTHER_LIMIT;
            if (sentence.length > limit) {
                violations.push({
                    filePath: record.filePath,
                    line: sentence.line,
                    sentence: normalizedSentence(sentence.sentence),
                    length: sentence.length,
                    limit,
                });
            }
        }
    });
    return violations;
}

function formatReason(violations) {
    const shown = violations.slice(0, 5);
    const items = shown.map(
        (item) =>
            `- File: ${item.filePath}\n` +
            `  Line: ${item.line}\n` +
            `  Sentence: ${item.sentence}\n` +
            `  Length: ${item.length} codepoints; limit: ${item.limit}\n` +
            "  Fix: split the sentence or rewrite it more briefly.",
    );
    const remaining =
        violations.length > shown.length
            ? `\n${violations.length - shown.length} more changed sentence(s) remain; fix these first and the hook will report the rest.`
            : "";
    return (
        `The edited Markdown contains ${violations.length} sentence(s) over the limit.\n` +
        items.join("\n") +
        remaining +
        "\nIf a definition or quotation must stay long, wrap only that text with blank lines around `<!-- textlint-disable sentence-length -->` and `<!-- textlint-enable sentence-length -->`."
    );
}

function formatGithubBodyReason(violations) {
    const bodyLengths = violations.filter((item) => item.kind === "total");
    const sentences = violations.filter(
        (item) => item.kind !== "paragraph" && item.kind !== "total",
    );
    const paragraphs = violations.filter((item) => item.kind === "paragraph");
    const reason = [];
    for (const item of bodyLengths.slice(0, 5)) {
        reason.push(
            `The edited GitHub body in ${item.filePath} contains ${item.length} prose codepoints; ` +
                `limit: ${item.limit}.`,
        );
        reason.push(
            "Fix: cut design records, reference lists, and repeated descriptions of the diff.",
        );
    }
    if (bodyLengths.length > 5) {
        reason.push(`${bodyLengths.length - 5} more GitHub body length violation(s) remain.`);
    }
    if (sentences.length > 0) {
        reason.push(formatReason(sentences));
    }
    if (paragraphs.length > 0) {
        reason.push(
            "The edited GitHub body contains " +
                paragraphs.length +
                " paragraph(s) or list item(s) over the 600-codepoint limit.",
        );
        reason.push(
            paragraphs
                .slice(0, 5)
                .map(
                    (item) =>
                        `- File: ${item.filePath}\n` +
                        "  Paragraph/list item: " +
                        item.preview +
                        "\n" +
                        "  Length: " +
                        item.length +
                        " codepoints; limit: " +
                        item.limit +
                        "\n" +
                        "  Fix: split the paragraph or list item.",
                )
                .join("\n"),
        );
        if (paragraphs.length > 5) {
            reason.push(
                (paragraphs.length - 5) +
                    " more paragraph(s) or list item(s) remain; split these first and the hook will report the rest.",
            );
        }
    }
    return reason.join("\n");
}

function block(reason) {
    process.stdout.write(`${JSON.stringify({ decision: "block", reason })}\n`);
}

async function formatClaudeMarkdown(filePaths, cwd) {
    if (filePaths.length === 0) {
        return;
    }
    const result = spawnSync("npx", ["prettier@2", "--write", ...filePaths], {
        cwd,
        encoding: "utf8",
        maxBuffer: 4 * 1024 * 1024,
    });
    if (result.error) {
        throw result.error;
    }
    if (result.status !== 0) {
        throw new Error(`Prettier failed: ${(result.stderr || result.stdout || "").trim()}`);
    }
}

async function checkRecords(event, client, requestedPaths = null) {
    const records = await recordsForPaths(event, client, requestedPaths);
    if (records.length === 0) {
        return [];
    }
    return changedViolations(records, await lintTexts(records));
}

// GitHub text must come from a --body-file this hook can read and lint, so
// every other form of these gh commands is denied before Bash runs.
const GITHUB_REPO_FLAG = String.raw`(?:\s+(?:-R(?:=|\s+)?|--repo(?:=|\s+))[^\s;&|()<>]*)*`;
const GITHUB_TEXT_COMMAND = new RegExp(
    String.raw`(?:^|[^\w./-])((?:[\w./-]*\/)?gh${GITHUB_REPO_FLAG}\s+(pr|issue)${GITHUB_REPO_FLAG}\s+(create|new|edit|comment|review|close|reopen)(?![\w-])[^;&|\n()<>\x60]*)`,
    "gu",
);
const GITHUB_BODY_REQUIRED = new Set(["pr create", "issue create", "pr comment", "issue comment"]);
const GITHUB_OTHER_BODY_SOURCES = new Set([
    "--fill", "-f", "--fill-first", "--fill-verbose", "--editor", "-e",
    "--web", "-w", "--template", "-T", "--recover",
]);

// Blank out comments, quoted text and quoted heredoc bodies, keeping every
// offset, so gh mentioned in prose, such as a prompt sent to another agent, is
// not taken for a command. Command substitutions that bash runs, inside double
// quotes or unquoted heredocs, stay visible.
// Returns the index just past the "))" that closes the arithmetic "((" at start.
function arithmeticEnd(command, start) {
    let depth = 0;
    for (let index = start; index < command.length; index += 1) {
        if (command[index] === "(") {
            depth += 1;
        } else if (command[index] === ")") {
            depth -= 1;
            if (depth === 0) {
                return index + 1;
            }
        }
    }
    return command.length;
}

function unquotedWord(word) {
    return word.replace(/\\(.)|'([^']*)'|"([^"]*)"/gsu, (_, escaped, single, double) => escaped ?? single ?? double);
}

function shellCodeText(command) {
    let out = "";
    const stack = [{ type: "code", parens: 0, closer: null }];
    const heredocs = [];
    for (let index = 0; index < command.length; index += 1) {
        const context = stack.at(-1);
        const character = command[index];
        if (context.type === "double") {
            if (character === "\\") {
                out += "  ";
                index += 1;
            } else if (character === '"') {
                stack.pop();
                out += " ";
            } else if (command.startsWith("$((", index)) {
                const stop = arithmeticEnd(command, index + 1);
                out += command.slice(index, stop);
                index = stop - 1;
            } else if (character === "$" && command[index + 1] === "(") {
                stack.push({ type: "code", parens: 0, closer: ")" });
                out += "$(";
                index += 1;
            } else if (character === "`") {
                stack.push({ type: "code", parens: 0, closer: "`" });
                out += "`";
            } else {
                out += character === "\n" ? "\n" : " ";
            }
            continue;
        }

        const wordStart = index === 0 || /[\s;&|()]/u.test(command[index - 1]);
        if (character === "#" && wordStart) {
            const lineEnd = command.indexOf("\n", index);
            const stop = lineEnd < 0 ? command.length : lineEnd;
            out += " ".repeat(stop - index);
            index = stop - 1;
        } else if (character === "$" && command[index + 1] === "'") {
            let stop = index + 2;
            while (stop < command.length && command[stop] !== "'") {
                stop += command[stop] === "\\" ? 2 : 1;
            }
            stop = Math.min(stop, command.length - 1);
            out += command.slice(index, stop + 1).replace(/[^\n]/g, " ");
            index = stop;
        } else if (character === "'") {
            const end = command.indexOf("'", index + 1);
            const stop = end < 0 ? command.length : end;
            out += command.slice(index, stop + 1).replace(/[^\n]/g, " ");
            index = stop;
        } else if (character === '"') {
            stack.push({ type: "double" });
            out += " ";
        } else if (character === "\\") {
            out += "  ";
            index += 1;
        } else if (character === "`" && context.closer === "`") {
            stack.pop();
            out += character;
        } else if (character === "`") {
            stack.push({ type: "code", parens: 0, closer: "`" });
            out += character;
        } else if (command.startsWith("$((", index) || (command.startsWith("((", index) && wordStart)) {
            const stop = arithmeticEnd(command, index + (character === "$" ? 1 : 0));
            out += command.slice(index, stop);
            index = stop - 1;
        } else if (character === "(") {
            context.parens += 1;
            out += character;
        } else if (character === ")" && context.parens === 0 && context.closer === ")") {
            stack.pop();
            out += character;
        } else if (character === ")") {
            context.parens = Math.max(0, context.parens - 1);
            out += character;
        } else if (command.startsWith("<<<", index)) {
            out += "<<<";
            index += 2;
        } else if (command.startsWith("<<", index)) {
            const heredoc = /^<<(-?)[ \t]*((?:\\.|'[^']*'|"[^"]*"|[^\s<>;&|()'"\\])+)/su.exec(command.slice(index));
            if (heredoc) {
                heredocs.push({
                    strip: heredoc[1] === "-",
                    quoted: /['"\\]/u.test(heredoc[2]),
                    delimiter: unquotedWord(heredoc[2]),
                });
                out += " ".repeat(heredoc[0].length);
                index += heredoc[0].length - 1;
            } else {
                out += character;
            }
        } else if (character === "\n" && heredocs.length > 0) {
            out += "\n";
            let lineStart = index + 1;
            for (const heredoc of heredocs.splice(0)) {
                const bodyStart = lineStart;
                while (lineStart <= command.length) {
                    const lineEnd = command.indexOf("\n", lineStart);
                    const end = lineEnd < 0 ? command.length : lineEnd;
                    const line = command.slice(lineStart, end);
                    lineStart = end + 1;
                    if ((heredoc.strip ? line.replace(/^\t+/u, "") : line) === heredoc.delimiter) {
                        break;
                    }
                }
                const body = command.slice(bodyStart, Math.min(lineStart, command.length));
                out += heredoc.quoted
                    ? body.replace(/[^\n]/g, " ")
                    : shellCodeText(`"${body.replace(/"/g, " ")}"`).slice(1, -1);
            }
            index = Math.min(lineStart, command.length) - 1;
        } else {
            out += character;
        }
    }
    return out;
}

function parseSimpleShellCommand(command) {
    const args = [];
    let argument = "";
    let active = false;
    let quote = null;

    for (let index = 0; index < command.length; index += 1) {
        const character = command[index];
        if (quote === "single") {
            if (character === "'") {
                quote = null;
            } else {
                argument += character;
            }
            continue;
        }
        if (quote === "double") {
            if (character === '"') {
                quote = null;
            } else if (character === "\\") {
                const next = command[index + 1];
                if (next === undefined || next === "\n") {
                    return null;
                }
                if (["$", "`", '"', "\\"].includes(next)) {
                    argument += next;
                } else {
                    argument += `\\${next}`;
                }
                index += 1;
                active = true;
            } else if (character === "$" || character === "`") {
                return null;
            } else {
                argument += character;
                active = true;
            }
            continue;
        }

        if (character === " " || character === "\t") {
            if (active) {
                args.push(argument);
                argument = "";
                active = false;
            }
        } else if (character === "\n" || character === "\r") {
            return null;
        } else if (character === "'") {
            quote = "single";
            active = true;
        } else if (character === '"') {
            quote = "double";
            active = true;
        } else if (character === "\\") {
            const next = command[index + 1];
            if (next === undefined) {
                return null;
            }
            if (next === "\n") {
                index += 1;
                continue;
            }
            argument += next;
            index += 1;
            active = true;
        } else if (character === "~" && !active) {
            const next = command[index + 1];
            if (next !== undefined && next !== "/" && !/\s/u.test(next)) {
                return null;
            }
            argument += process.env.HOME || os.homedir();
            active = true;
        } else if (character === "#" && !active) {
            break;
        } else if (/[;&|<>()\[\]{}*?!$`]/u.test(character)) {
            return null;
        } else {
            argument += character;
            active = true;
        }
    }

    if (quote !== null) {
        return null;
    }
    if (active) {
        args.push(argument);
    }
    return args;
}

const githubCommonFlags = new Map([
    ["--body", "body"],
    ["-b", "body"],
    ["--body-file", "file"],
    ["-F", "file"],
    ["--attach", "value"],
    ["--repo", "value"],
    ["-R", "value"],
    ["--help", "boolean"],
    ["-h", "boolean"],
]);

const githubCommandFlags = {
    "pr create": {
        value: "--title -t --base -B --head -H --reviewer -r --assignee -a --label -l --project -p --milestone -m --recover --template -T",
        boolean: "--draft -d --editor -e --web -w --fill-verbose --fill -f --fill-first --no-maintainer-edit --dry-run",
    },
    "pr edit": {
        value: "--title -t --base -B --add-reviewer --remove-reviewer --add-assignee --remove-assignee --add-label --remove-label --add-project --remove-project --milestone -m",
        boolean: "--remove-milestone",
    },
    "pr comment": {
        value: "",
        boolean: "--editor -e --web -w --edit-last --delete-last --yes --create-if-none",
    },
    "pr review": {
        value: "",
        boolean: "--approve -a --comment -c --request-changes -r",
    },
    "issue create": {
        value: "--title -t --assignee -a --label -l --project -p --milestone -m --recover --template -T --type --parent --blocked-by --blocking",
        boolean: "--editor -e --web -w",
    },
    "issue edit": {
        value: "--title -t --add-assignee --remove-assignee --add-label --remove-label --add-project --remove-project --milestone -m --type --parent --add-sub-issue --remove-sub-issue --add-blocked-by --remove-blocked-by --add-blocking --remove-blocking",
        boolean: "--remove-milestone --remove-type --remove-parent",
    },
    "issue comment": {
        value: "",
        boolean: "--editor -e --web -w --edit-last --delete-last --yes --create-if-none",
    },
};

function parsePflagBoolean(value) {
    if (["1", "t", "T", "TRUE", "true", "True"].includes(value)) {
        return true;
    }
    if (["0", "f", "F", "FALSE", "false", "False"].includes(value)) {
        return false;
    }
    return null;
}

// Returns one entry per gh call that can post GitHub text: { name, problem }
// when it must be denied, and { name, bodyFile } or { name } when it may run.
function githubTextCalls(command) {
    const code = shellCodeText(command);
    const changesDirectory = /(?:^|[^\w./-])(?:cd|pushd)(?:\s|$)/u.test(code);
    return [...code.matchAll(GITHUB_TEXT_COMMAND)]
        .filter((match) => `${match[2]} ${match[3]}` !== "issue review")
        .map((match) => {
            const name = `${match[2]} ${match[3] === "new" ? "create" : match[3]}`;
            const start = match.index + match[0].length - match[1].length;
            const args = parseSimpleShellCommand(command.slice(start, start + match[1].length));
            const words = (args || []).filter(
                (arg, index, all) =>
                    !/^(?:-R.*|--repo(?:=.*)?)$/u.test(arg) && !/^(?:-R|--repo)$/u.test(all[index - 1] || ""),
            );
            if (["close", "reopen"].includes(match[3])) {
                return closingComment(args ? words.slice(3) : null, match[1]) ? { name, problem: "it posts a comment with --comment" } : null;
            }
            if (!args || path.basename(words[0]) !== "gh" || `${words[1]} ${words[2]}` !== `${match[2]} ${match[3]}`) {
                return {
                    name,
                    problem: "its arguments need shell expansion, such as a variable, $(...), a glob, or a heredoc",
                };
            }
            const call = githubTextCall(words.slice(3), name);
            if (call?.bodyFile && changesDirectory && !path.isAbsolute(call.bodyFile)) {
                return { name, problem: "the command changes directory, so the --body-file path must be absolute" };
            }
            if (call?.bodyFile && command.slice(0, start).includes(path.basename(call.bodyFile))) {
                return {
                    name,
                    problem: "the command names the body file before gh, so it may change the file after this check",
                };
            }
            return call
                ? { ...call, commandStart: start, repository: githubRepositoryArgument(args) }
                : call;
        })
        .filter(Boolean);
}

function githubRepositoryArgument(args) {
    for (let index = 0; index < args.length; index += 1) {
        const option = args[index];
        if (option === "--") {
            break;
        }
        if (option === "-R" || option === "--repo") {
            return args[index + 1] || null;
        }
        if (option.startsWith("--repo=")) {
            return option.slice("--repo=".length) || null;
        }
        if (option.startsWith("-R")) {
            return option.slice(option[2] === "=" ? 3 : 2) || null;
        }
    }
    return process.env.GH_REPO || null;
}

function githubRepositoryAddress(value) {
    if (typeof value !== "string") {
        return null;
    }
    let hostname = process.env.GH_HOST || "github.com";
    let repositoryPath = value.trim();
    let hasExplicitHostname = false;
    const scpRemote = /^[^@/]+@([^:/]+):(.+)$/u.exec(repositoryPath);
    if (scpRemote) {
        hostname = scpRemote[1];
        repositoryPath = scpRemote[2];
        hasExplicitHostname = true;
    } else {
        try {
            const url = new URL(repositoryPath);
            hostname = url.hostname;
            repositoryPath = url.pathname;
            hasExplicitHostname = true;
        } catch {
            repositoryPath = repositoryPath.replace(/^[^/]+:\/\//u, "");
        }
    }
    repositoryPath = repositoryPath.replace(/\.git$/iu, "").replace(/\/+$/u, "");
    const parts = repositoryPath.split("/").filter(Boolean);
    if (parts.length >= 3 && !hasExplicitHostname) {
        hostname = parts.at(-3);
    }
    if (parts.length < 2) {
        return null;
    }
    return {
        hostname: hostname.toLowerCase(),
        owner: parts.at(-2),
        name: parts.at(-1),
    };
}

function repositoryAddressFromRemote(remoteUrl) {
    const address = githubRepositoryAddress(remoteUrl);
    return address ? `${address.hostname}/${address.owner}/${address.name}`.toLowerCase() : "";
}

function localGitRemotes(root) {
    const result = spawnSync("git", ["-C", root, "remote", "-v"], {
        encoding: "utf8",
        timeout: 1000,
    });
    const remotes = new Map();
    for (const line of (result.stdout || "").split("\n")) {
        const match = /^(\S+)\s+(\S+)/u.exec(line);
        if (match && !remotes.has(match[1])) {
            remotes.set(match[1], repositoryAddressFromRemote(match[2]));
        }
    }
    return remotes;
}

function localRepositoryRoot(directory, targetRepository) {
    const rootResult = spawnSync("git", ["-C", directory, "rev-parse", "--show-toplevel"], {
        encoding: "utf8",
        timeout: 1000,
    });
    if (rootResult.status !== 0 || !rootResult.stdout.trim()) {
        return null;
    }
    const root = path.resolve(rootResult.stdout.trim());
    if (!targetRepository) {
        return root;
    }

    const target = githubRepositoryAddress(targetRepository);
    if (!target) {
        return null;
    }
    const remotes = localGitRemotes(root);
    const targetAddress = `${target.hostname}/${target.owner}/${target.name}`.toLowerCase();
    return remotes.size > 0 && [...remotes.values()].includes(targetAddress) ? root : null;
}

async function caseInsensitiveChildDirectories(parent, name) {
    const entries = await fs.readdir(parent, { withFileTypes: true }).catch(() => []);
    return entries
        .filter(
            (candidate) =>
                candidate.isDirectory() && candidate.name.toLowerCase() === name.toLowerCase(),
        )
        .map((entry) => path.join(parent, entry.name));
}

async function pullRequestTemplateContents(repositoryRoot) {
    const repositorySubdirectories = await Promise.all(
        ["docs", ".github"].map((name) => caseInsensitiveChildDirectories(repositoryRoot, name)),
    );
    const locations = [repositoryRoot, ...repositorySubdirectories.flat()];

    const templateFiles = new Set();
    for (const directory of locations) {
        const entries = await fs.readdir(directory, { withFileTypes: true }).catch(() => []);
        for (const entry of entries) {
            if (entry.isFile() && /^pull_request_template\.(?:md|txt)$/iu.test(entry.name)) {
                templateFiles.add(path.join(directory, entry.name));
            }
        }

        const multipleTemplateDirectories = await caseInsensitiveChildDirectories(
            directory,
            "PULL_REQUEST_TEMPLATE",
        );
        for (const multipleTemplates of multipleTemplateDirectories) {
            const multipleTemplateEntries = await fs
                .readdir(multipleTemplates, { withFileTypes: true })
                .catch(() => []);
            for (const entry of multipleTemplateEntries) {
                if (entry.isFile() && /\.(?:md|txt)$/iu.test(entry.name)) {
                    templateFiles.add(path.join(multipleTemplates, entry.name));
                }
            }
        }
    }

    return Promise.all([...templateFiles].map((filePath) => fs.readFile(filePath, "utf8")));
}

function localDefaultBranchTemplateContents(repositoryRoot, targetRepository) {
    const remotes = localGitRemotes(repositoryRoot);
    let remoteName;
    if (targetRepository) {
        const target = githubRepositoryAddress(targetRepository);
        if (!target) {
            return null;
        }
        const targetAddress = `${target.hostname}/${target.owner}/${target.name}`.toLowerCase();
        remoteName = [...remotes].find(([, address]) => address === targetAddress)?.[0];
    } else if (remotes.has("origin")) {
        remoteName = "origin";
    }
    if (!remoteName) {
        return null;
    }

    const defaultRef = spawnSync(
        "git",
        ["-C", repositoryRoot, "symbolic-ref", "--quiet", `refs/remotes/${remoteName}/HEAD`],
        { encoding: "utf8", timeout: 1000 },
    );
    if (defaultRef.status !== 0 || !defaultRef.stdout.trim()) {
        return null;
    }
    const ref = defaultRef.stdout.trim();
    const tree = spawnSync("git", ["-C", repositoryRoot, "ls-tree", "-r", "--name-only", ref], {
        encoding: "utf8",
        timeout: 1000,
        maxBuffer: 8 * 1024 * 1024,
    });
    if (tree.status !== 0) {
        return null;
    }

    const templates = [];
    for (const templatePath of tree.stdout.split("\n").filter(isPullRequestTemplatePath)) {
        const content = spawnSync("git", ["-C", repositoryRoot, "show", `${ref}:${templatePath}`], {
            encoding: "utf8",
            timeout: 1000,
            maxBuffer: 8 * 1024 * 1024,
        });
        if (content.status === 0) {
            templates.push(content.stdout);
        }
    }
    return templates;
}

function githubApiJson(hostname, endpoint, cwd) {
    const result = spawnSync("gh", ["api", "--hostname", hostname, endpoint], {
        cwd,
        encoding: "utf8",
        timeout: 5000,
        maxBuffer: 8 * 1024 * 1024,
    });
    if (result.status !== 0) {
        return null;
    }
    try {
        return JSON.parse(result.stdout);
    } catch {
        return null;
    }
}

function isPullRequestTemplatePath(filePath) {
    const parts = filePath.split("/").map((part) => part.toLowerCase());
    const file = parts.at(-1);
    if (!/\.(?:md|txt)$/u.test(file)) {
        return false;
    }
    const defaultTemplate = file === "pull_request_template.md" || file === "pull_request_template.txt";
    if (parts.length === 1 || (parts.length === 2 && ["docs", ".github"].includes(parts[0]))) {
        return defaultTemplate;
    }
    const multipleTemplateDirectory =
        (parts.length === 2 && parts[0] === "pull_request_template") ||
        (parts.length === 3 && ["docs", ".github"].includes(parts[0]) && parts[1] === "pull_request_template");
    return multipleTemplateDirectory;
}

async function remotePullRequestTemplateContents(repository, cwd) {
    const address = githubRepositoryAddress(repository);
    if (
        !address ||
        !/^[\w.-]+$/u.test(address.hostname) ||
        !/^[\w.-]+$/u.test(address.owner) ||
        !/^[\w.-]+$/u.test(address.name)
    ) {
        return [];
    }
    const repositoryPath = `repos/${address.owner}/${address.name}`;
    const metadata = githubApiJson(address.hostname, repositoryPath, cwd);
    if (typeof metadata?.default_branch !== "string" || !metadata.default_branch) {
        return [];
    }
    const branch = encodeURIComponent(metadata.default_branch);
    const tree = githubApiJson(
        address.hostname,
        `${repositoryPath}/git/trees/${branch}?recursive=1`,
        cwd,
    );
    if (!Array.isArray(tree?.tree)) {
        return [];
    }
    const templatePaths = tree.tree
        .filter((entry) => entry.type === "blob" && isPullRequestTemplatePath(entry.path))
        .map((entry) => entry.path);
    const contents = [];
    for (const templatePath of templatePaths) {
        const encodedPath = templatePath.split("/").map(encodeURIComponent).join("/");
        const file = githubApiJson(
            address.hostname,
            `${repositoryPath}/contents/${encodedPath}?ref=${branch}`,
            cwd,
        );
        if (file?.encoding === "base64" && typeof file.content === "string") {
            contents.push(Buffer.from(file.content, "base64").toString("utf8"));
        }
    }
    return contents;
}

function removeTemplateLine(bodyLine, templateLine) {
    const normalizeTaskMarker = (line) =>
        line.replace(/^([ \t]*(?:[-+*]|\d+[.)])[ \t]+)\[[ xX]\]([ \t]+)/u, "$1[ ]$2");
    if (
        normalizeTaskMarker(bodyLine) !== normalizeTaskMarker(templateLine) ||
        /^ {0,3}(?:`{3,}|~{3,})/u.test(templateLine) ||
        templateLine.includes("|")
    ) {
        return null;
    }
    const prefix = /^([ \t]{0,3}#{1,6}[ \t]+|[ \t]*(?:[-+*]|\d+[.)])[ \t]+(?:\[[ xX]\][ \t]+)?|[ \t]{0,3}(?:>[ \t]?)+)/u.exec(bodyLine)?.[0] || "";
    return prefix + "<!-- template boilerplate -->";
}

function removePullRequestTemplateProse(body, templates) {
    const bodyLines = body.replace(/\r\n?/gu, "\n").split("\n");
    const maximumLineCounts = new Map();
    for (const template of templates) {
        const counts = new Map();
        for (const line of template.replace(/\r\n?/gu, "\n").split("\n")) {
            if (line.trim()) {
                counts.set(line, (counts.get(line) || 0) + 1);
            }
        }
        for (const [line, count] of counts) {
            maximumLineCounts.set(line, Math.max(maximumLineCounts.get(line) || 0, count));
        }
    }

    for (const [templateLine, count] of maximumLineCounts) {
        for (let occurrence = 0; occurrence < count; occurrence += 1) {
            const index = bodyLines.findIndex((line) => removeTemplateLine(line, templateLine) !== null);
            if (index < 0) {
                break;
            }
            bodyLines[index] = removeTemplateLine(bodyLines[index], templateLine);
        }
    }
    return bodyLines.join("\n");
}

function githubCommandWorkingDirectory(command, commandStart, directory) {
    const prefix = command.slice(0, commandStart);
    const code = shellCodeText(prefix);
    let cwd = path.resolve(directory || process.cwd());
    for (const match of code.matchAll(/(?:^|[;&|\n])\s*(cd|pushd)(?=\s|$)/gu)) {
        const start = match.index + match[0].lastIndexOf(match[1]);
        const end = /[;&|\n]/u.exec(code.slice(start))?.index;
        const args = parseSimpleShellCommand(prefix.slice(start, end === undefined ? prefix.length : start + end));
        if (
            args?.[0] === match[1] &&
            (match[1] === "cd" ? args.length <= 2 : args.length === 2)
        ) {
            cwd = path.resolve(cwd, args[1] || os.homedir());
        }
    }
    return cwd;
}

async function githubBodyLengthText(event, call, body) {
    if (!call.name.startsWith("pr ") || !GITHUB_BODY_TOTAL_LIMIT_COMMANDS.has(call.name)) {
        return undefined;
    }
    const cwd = githubCommandWorkingDirectory(
        event.tool_input.command,
        call.commandStart,
        event.cwd,
    );
    const repositoryRoot = localRepositoryRoot(cwd, call.repository);
    let templates;
    if (repositoryRoot) {
        templates = localDefaultBranchTemplateContents(repositoryRoot, call.repository);
        if (templates === null) {
            templates = call.repository
                ? await remotePullRequestTemplateContents(call.repository, cwd)
                : await pullRequestTemplateContents(repositoryRoot);
        }
    } else {
        templates = call.repository
            ? await remotePullRequestTemplateContents(call.repository, cwd)
            : [];
    }
    return templates.length > 0 ? removePullRequestTemplateProse(body, templates) : undefined;
}

// close and reopen accept only inline comment text, so any --comment is denied.
function closingComment(args, segment) {
    if (!args) {
        return /(?:^|\s)(?:--comment|-[A-Za-z]*c)/u.test(segment);
    }
    for (const arg of args) {
        if (arg === "--") {
            return false;
        }
        if (/^--comment(?:=|$)/u.test(arg)) {
            return true;
        }
        if (/^-[A-Za-z]/u.test(arg)) {
            for (const flag of arg.slice(1)) {
                if (flag === "c") {
                    return true;
                }
                if (flag === "r" || flag === "=") {
                    break;
                }
            }
        }
    }
    return false;
}

function githubTextCall(args, name) {
    const flags = new Map(githubCommonFlags);
    const commandFlags = githubCommandFlags[name];
    for (const flag of commandFlags.value.split(/\s+/u).filter(Boolean)) {
        flags.set(flag, "value");
    }
    for (const flag of commandFlags.boolean.split(/\s+/u).filter(Boolean)) {
        flags.set(flag, "boolean");
    }

    let inline = false;
    let bodyFile;
    let deleteLast = false;
    let attach = false;
    let helpRequested = false;
    const otherSources = new Set();
    const setBoolean = (flag, value) => {
        if (flag === "--help" || flag === "-h") {
            helpRequested = value;
        } else if (flag === "--delete-last") {
            deleteLast = value;
        } else if (value && GITHUB_OTHER_BODY_SOURCES.has(flag)) {
            otherSources.add(flag);
        }
    };
    const setValue = (flag, type, value) => {
        if (type === "body") {
            inline = true;
        } else if (type === "file") {
            bodyFile = value;
        } else if (flag === "--attach") {
            attach = true;
        } else if (GITHUB_OTHER_BODY_SOURCES.has(flag)) {
            otherSources.add(flag);
        }
    };
    const unsupported = (flag) => ({ name, problem: `the hook does not recognize the option ${flag}` });

    for (let index = 0; index < args.length; index += 1) {
        const option = args[index];
        if (option === "--") {
            break;
        }
        if (!option.startsWith("-") || option === "-") {
            continue;
        }

        if (option.startsWith("--")) {
            const equalIndex = option.indexOf("=");
            const flag = equalIndex < 0 ? option : option.slice(0, equalIndex);
            const type = flags.get(flag);
            if (!type) {
                return unsupported(flag);
            }
            if (type === "boolean") {
                const value = equalIndex < 0 ? true : parsePflagBoolean(option.slice(equalIndex + 1));
                if (value === null) {
                    return unsupported(option);
                }
                setBoolean(flag, value);
                continue;
            }

            const value = equalIndex < 0 ? args[++index] : option.slice(equalIndex + 1);
            if (value === undefined) {
                return unsupported(flag);
            }
            setValue(flag, type, value);
            continue;
        }

        let shorthand = option.slice(1);
        while (shorthand) {
            const flag = `-${shorthand[0]}`;
            const type = flags.get(flag);
            if (!type) {
                return unsupported(flag);
            }
            const attached = shorthand.slice(1);
            if (type === "boolean") {
                if (attached.startsWith("=")) {
                    const value = parsePflagBoolean(attached.slice(1));
                    if (value === null) {
                        return unsupported(option);
                    }
                    setBoolean(flag, value);
                    break;
                }
                setBoolean(flag, true);
                shorthand = attached;
                continue;
            }

            const value =
                attached.startsWith("=") && attached.length > 1
                    ? attached.slice(1)
                    : attached || args[++index];
            if (value === undefined) {
                return unsupported(flag);
            }
            setValue(flag, type, value);
            break;
        }
    }

    if (helpRequested) {
        return null;
    }
    if (inline) {
        return { name, problem: "it passes inline text with --body or -b" };
    }
    if (otherSources.size > 0) {
        return { name, problem: `it takes the body from ${[...otherSources].join(", ")}` };
    }
    if (bodyFile === "-") {
        return { name, problem: "it reads the body from standard input" };
    }
    if (bodyFile === "") {
        return { name, problem: "its --body-file path is empty" };
    }
    if (bodyFile === undefined && GITHUB_BODY_REQUIRED.has(name) && !deleteLast && !attach) {
        return { name, problem: "it has no --body-file" };
    }
    return { name, bodyFile };
}

function formatGithubCommandReason(name, problem) {
    const [kind, subcommand] = name.split(" ");
    if (subcommand === "close" || subcommand === "reopen") {
        return (
            `Blocked \`gh ${name}\`: ${problem}.\n` +
            "GitHub text must come from a Markdown file that this hook can lint. " +
            "Write the comment to a .md file with the file-editing tool, then run:\n" +
            `gh ${kind} comment <number> -R <owner>/<repo> --body-file /absolute/path/body.md\n` +
            `Then run \`gh ${name}\` without --comment.`
        );
    }
    const target = name.endsWith("create") ? "" : " <number>";
    const extra = {
        "pr create": ' --head <branch> --title "<title>"',
        "issue create": ' --title "<title>"',
        "pr review": " --comment",
    }[name] || "";
    return (
        `Blocked \`gh ${name}\`: ${problem}.\n` +
        "GitHub text must come from a Markdown file that this hook can lint. " +
        "Write the body to a .md file with the file-editing tool, then run:\n" +
        `gh ${name}${target} -R <owner>/<repo>${extra} --body-file /absolute/path/body.md\n` +
        "Give every gh argument literally. Do not use --body, -b, --fill, --template, --editor, --web, stdin, a heredoc, a variable, or $(...) in the gh call."
    );
}

async function checkGithubCommand(event) {
    const input = event.tool_input || {};
    if (typeof input.command !== "string") {
        return null;
    }

    const calls = githubTextCalls(input.command);
    const denied = calls.find((call) => call.problem);
    if (denied) {
        return formatGithubCommandReason(denied.name, denied.problem);
    }

    const records = [];
    for (const call of calls.filter((entry) => entry.bodyFile !== undefined)) {
        const filePath = path.resolve(event.cwd || process.cwd(), call.bodyFile);
        const stat = await fs.stat(filePath).catch(() => null);
        if (!stat?.isFile()) {
            return formatGithubCommandReason(call.name, `the body file ${filePath} is not a regular file`);
        }
        const current = await fs.readFile(filePath, "utf8");
        const bodyLengthText = await githubBodyLengthText(event, call, current);
        records.push({
            filePath,
            commandName: call.name,
            baseline: "",
            current,
            ...(bodyLengthText === undefined ? {} : { bodyLengthText }),
        });
    }
    if (records.length === 0) {
        return null;
    }

    const diagnostics = await lintTexts(records, true);
    const violations = [
        ...changedViolations(records, diagnostics),
        ...diagnostics.flatMap((diagnostic, index) => {
            if (
                !GITHUB_BODY_TOTAL_LIMIT_COMMANDS.has(records[index].commandName) ||
                diagnostic.bodyLength <= GITHUB_BODY_PROSE_LIMIT
            ) {
                return [];
            }
            return [{
                kind: "total",
                filePath: records[index].filePath,
                length: diagnostic.bodyLength,
                limit: GITHUB_BODY_PROSE_LIMIT,
            }];
        }),
        ...diagnostics.flatMap((diagnostic, index) =>
            diagnostic.blocks.map((item) => ({ ...item, filePath: records[index].filePath })),
        ),
    ];
    return violations.length > 0 ? formatGithubBodyReason(violations) : null;
}

async function removeSession(event, client) {
    await fs.rm(sessionDirectory(event, client), { recursive: true, force: true });
}

async function main() {
    const [action, client] = process.argv.slice(2);
    if (!["pre", "post", "stop"].includes(action) || !["claude", "codex"].includes(client)) {
        throw new Error("usage: markdown-sentence-length <pre|post|stop> <claude|codex>");
    }

    const event = JSON.parse(fsSync.readFileSync(0, "utf8") || "{}");
    if (action === "stop" && event.stop_hook_active === true) {
        await removeSession(event, client);
        return;
    }

    if (action === "pre") {
        if (event.tool_name === "Bash") {
            const reason = await checkGithubCommand(event);
            if (reason) {
                block(reason);
            }
            return;
        }
        await captureBefore(event, client);
        return;
    }

    const filePaths = eventPaths(event);
    if (action === "post" && client === "claude") {
        await formatClaudeMarkdown(filePaths, path.resolve(event.cwd || process.cwd()));
    }

    const violations = await checkRecords(
        event,
        client,
        action === "post" ? filePaths : null,
    );
    if (violations.length > 0) {
        block(formatReason(violations));
        return;
    }

    if (action === "stop") {
        await removeSession(event, client);
    }
}

main().catch(() => {});
